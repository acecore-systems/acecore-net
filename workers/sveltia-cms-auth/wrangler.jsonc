{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sveltia-cms-auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-05",
  "workers_dev": true,
  "keep_vars": true,
  "secrets_store_secrets": [
    {
      "binding": "GITHUB_CLIENT_SECRET_STORE",
      "store_id": "f59c889c0fcc405794a34401fb09240c",
      "secret_name": "sveltia-cms-auth-github-client-secret",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "secrets": {
    "required": ["GITHUB_CLIENT_ID"],
  },
  // ALLOWED_DOMAINS and GITHUB_SCOPE are managed on the shared Worker.
  // Explicit vars override dashboard values even with keep_vars enabled.
}
