{
  "name": "acecore-net",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/write-cms-runtime-config.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/write-cms-runtime-config.mjs",
    "build": "astro build && node scripts/enrich-sitemap-lastmod.mjs && pagefind --site dist && node scripts/build-search-corpus.mjs && node scripts/write-build-meta.mjs",
    "preview": "astro preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:blog-freshness": "node --test --test-isolation=none tests/blog-freshness.test.mjs",
    "test:cms": "node --import ./tests/register-json-module-hooks.mjs tests/cms-proxy.test.mjs && node --import ./tests/register-json-module-hooks.mjs tests/cms-blog-freshness-validator.test.mjs && node tests/render-safety.test.mjs && node --experimental-strip-types tests/translation-merge.test.ts",
    "test:translation-merge": "node --experimental-strip-types --test tests/translation-merge.test.ts",
    "test:openai-translation": "node --experimental-strip-types --test tests/openai-translation-batch.test.ts",
    "test:cms-auth": "node --experimental-strip-types --test tests/sveltia-cms-auth.test.ts",
    "test:ai-chat": "node --experimental-strip-types --test tests/ai-contact.test.mjs",
    "test:contact": "node --experimental-strip-types --test tests/contact-api.test.mjs tests/contact-page-turnstile.test.mjs tests/specialist-url.test.mjs",
    "test:site-config": "node --experimental-strip-types --test --test-isolation=none tests/monetized-blog-path.test.mjs && node --experimental-strip-types --test --test-isolation=none tests/search-modal-spa-style.test.mjs && node --test --test-isolation=none tests/pagefind-headers.test.mjs",
    "test:deployment-marker": "node --experimental-strip-types --test tests/deployment-marker.test.ts",
    "test:search": "node --experimental-strip-types --test tests/deployment-marker.test.ts tests/search-api.test.mjs tests/network-search-api.test.mjs tests/search-corpus.test.mjs tests/vectorize-sync.test.mjs tests/vectorize-workflow.test.mjs",
    "sync:vectorize": "node --experimental-strip-types scripts/sync-vectorize.ts",
    "sync:vectorize:dry-run": "node --experimental-strip-types scripts/sync-vectorize.ts --dry-run",
    "types:cloudflare": "wrangler types functions/cloudflare-env.d.ts --env-interface CloudflareEnv --include-runtime false",
    "types:cloudflare:check": "wrangler types functions/cloudflare-env.d.ts --env-interface CloudflareEnv --include-runtime false --check",
    "types:cms-auth": "wrangler types workers/sveltia-cms-auth/worker-configuration.d.ts --config workers/sveltia-cms-auth/wrangler.jsonc --env-interface SveltiaCmsAuthConfig --include-runtime false",
    "types:cms-auth:check": "wrangler types workers/sveltia-cms-auth/worker-configuration.d.ts --config workers/sveltia-cms-auth/wrangler.jsonc --env-interface SveltiaCmsAuthConfig --include-runtime false --check",
    "check:pages-config": "wrangler pages functions build --outdir .wrangler/pages-functions",
    "typecheck:functions": "tsc --project tsconfig.functions.json",
    "typecheck:cms-auth": "tsc --project workers/sveltia-cms-auth/tsconfig.json",
    "typecheck:admin": "tsc --project tsconfig.admin.json",
    "typecheck:translation-merge": "tsc --project tsconfig.translation-merge.json",
    "typecheck:openai-translation": "tsc --project tsconfig.openai-translation.json",
    "typecheck:deployment-marker": "tsc --project tsconfig.deployment-marker.json",
    "typecheck:vectorize-sync": "tsc --project tsconfig.vectorize-sync.json",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:blog-freshness": "node scripts/validate-blog-freshness.mjs",
    "validate:seo": "node scripts/enrich-sitemap-lastmod.mjs --check && node scripts/validate-seo.mjs",
    "validate:tag-redirects": "node --experimental-strip-types scripts/validate-tag-redirects.mjs",
    "validate:legacy-redirects": "node --experimental-strip-types scripts/validate-legacy-redirects.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "astro": "^7.1.3",
    "graphql": "^17.0.2",
    "jose": "^6.2.4",
    "js-yaml": "^4.3.0",
    "rehype-external-links": "^3.0.0",
    "satori": "^0.29.0",
    "sharp": "^0.35.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260726.1",
    "@iconify-json/lucide": "^1.2.120",
    "@types/js-yaml": "^4.0.9",
    "@unocss/astro": "^66.7.5",
    "@unocss/preset-typography": "^66.7.5",
    "cheerio": "^1.2.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^7.0.2",
    "unocss": "^66.7.5",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
