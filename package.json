{
  "name": "acecore-net",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/write-cms-runtime-config.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/write-cms-runtime-config.mjs",
    "build": "astro build && node scripts/enrich-sitemap-lastmod.mjs && pagefind --site dist && node scripts/build-search-corpus.mjs && node scripts/write-build-meta.mjs",
    "preview": "astro preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:cms": "node --test tests/cms-proxy.test.mjs",
    "test:search": "node --experimental-strip-types --test tests/deployment-marker.test.mjs tests/search-api.test.mjs tests/search-corpus.test.mjs tests/vectorize-sync.test.mjs",
    "sync:vectorize": "node scripts/sync-vectorize.mjs",
    "sync:vectorize:dry-run": "node scripts/sync-vectorize.mjs --dry-run",
    "types:cloudflare": "wrangler types functions/cloudflare-env.d.ts --env-interface CloudflareEnv --include-runtime false",
    "types:cloudflare:check": "wrangler types functions/cloudflare-env.d.ts --env-interface CloudflareEnv --include-runtime false --check",
    "check:pages-config": "wrangler pages functions build --outdir .wrangler/pages-functions",
    "typecheck:functions": "tsc --project tsconfig.functions.json",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:seo": "node scripts/enrich-sitemap-lastmod.mjs --check && node scripts/validate-seo.mjs",
    "validate:tag-redirects": "node --experimental-strip-types scripts/validate-tag-redirects.mjs",
    "validate:legacy-redirects": "node scripts/validate-legacy-redirects.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "astro": "^7.1.3",
    "graphql": "^17.0.2",
    "rehype-external-links": "^3.0.0",
    "satori": "^0.29.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260726.1",
    "@iconify-json/lucide": "^1.2.120",
    "@unocss/astro": "^66.7.5",
    "@unocss/preset-typography": "^66.7.5",
    "cheerio": "^1.2.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^7.0.2",
    "unocss": "^66.7.5",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
