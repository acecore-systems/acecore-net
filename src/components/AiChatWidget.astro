---
import ChatIcon from './ChatIcon.astro'
import '../styles/shared-chat.css'
import { t, getLocaleFromUrl, getLocalizedUrl, type Locale } from '../i18n'
import { SITE } from '../data/site'

interface Props {
  locale?: Locale
  showFloatingToggle?: boolean
}

const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url)
const { showFloatingToggle = true } = Astro.props
const contactUrl = getLocalizedUrl('/contact/', locale)
const [emailUser, emailDomain = ''] = SITE.email.split('@')
const phoneParts = SITE.phone.split('-')
---

<div
  id="ace-ai-chat"
  class="ac-chat"
  data-locale={locale}
  data-loading={t(locale, 'aiChat.loading')}
  data-error={t(locale, 'aiChat.error')}
  data-greeting={t(locale, 'aiChat.greeting')}
  data-contact-url={contactUrl}
  data-email-user={emailUser}
  data-email-domain={emailDomain}
  data-phone-parts={phoneParts.join('|')}
>
  <section
    id="ace-ai-chat-panel"
    class="ac-chat__panel hidden"
    role="dialog"
    aria-modal="false"
    aria-labelledby="ace-ai-chat-title"
    aria-describedby="ace-ai-chat-lead"
    tabindex="-1"
  >
    <header class="ac-chat__header">
      <span class="ac-chat__mark">
        <ChatIcon name="bot" />
      </span>
      <div class="ac-chat__heading">
        <h2 id="ace-ai-chat-title">{t(locale, 'aiChat.title')}</h2>
        <p id="ace-ai-chat-lead">{t(locale, 'aiChat.lead')}</p>
      </div>
      <button
        type="button"
        class="ac-chat__close"
        data-ace-chat-close
        aria-label={t(locale, 'aiChat.close')}
      >
        <ChatIcon name="close" />
      </button>
    </header>
    <div
      id="ace-ai-chat-messages"
      class="ac-chat__messages"
      role="log"
      aria-live="polite"
      aria-relevant="additions text"
    ></div>
    <div class="ac-chat__prompts">
      {['quickServices', 'quickEstimate', 'quickSchools'].map((key) => (
        <button type="button" data-ace-chat-prompt>
          {t(locale, `aiChat.${key}`)}
        </button>
      ))}
    </div>
    <form id="ace-ai-chat-form" class="ac-chat__form">
      <label for="ace-ai-chat-input" class="sr-only">
        {t(locale, 'aiChat.inputLabel')}
      </label>
      <div class="ac-chat__input-row">
        <textarea
          id="ace-ai-chat-input"
          rows="2"
          maxlength="800"
          placeholder={t(locale, 'aiChat.placeholder')}
        ></textarea>
        <button
          type="submit"
          id="ace-ai-chat-submit"
          class="ac-chat__send"
          aria-label={t(locale, 'aiChat.send')}
        >
          <ChatIcon name="send" />
        </button>
      </div>
    </form>
    <div class="ac-chat__footer">
      <nav>
        <a href={contactUrl}>{t(locale, 'aiChat.contactForm')}</a>
        <a href={SITE.line} target="_blank" rel="noopener noreferrer">
          {t(locale, 'aiChat.line')} ↗
        </a>
        <a href={getLocalizedUrl('/privacy/', locale)}>
          {t(locale, 'footer.privacy')}
        </a>
      </nav>
    </div>
  </section>
  <button
    type="button"
    id="ace-ai-chat-toggle"
    class:list={['ac-chat__toggle', { hidden: !showFloatingToggle }]}
    aria-controls="ace-ai-chat-panel"
    aria-expanded="false"
    aria-haspopup="dialog"
    aria-label={t(locale, 'aiChat.open')}
    data-ace-chat-toggle
  >
    <ChatIcon name="bot" />
    <span aria-hidden="true">AI</span>
  </button>
</div>
<script>
  import '../scripts/shared-chat-viewport'
</script>

<script is:inline>
  ;(() => {
    function initAceAiChat() {
      const root = document.getElementById('ace-ai-chat')
      if (!root || root.dataset.initialized === 'true') return
      root.dataset.initialized = 'true'

      const panel = document.getElementById('ace-ai-chat-panel')
      const toggle = document.getElementById('ace-ai-chat-toggle')
      const form = document.getElementById('ace-ai-chat-form')
      const input = document.getElementById('ace-ai-chat-input')
      const submit = document.getElementById('ace-ai-chat-submit')
      const messagesEl = document.getElementById('ace-ai-chat-messages')
      if (!panel || !toggle || !form || !input || !submit || !messagesEl) return
      const listeners = new AbortController()
      document.addEventListener('astro:before-swap', () => listeners.abort(), {
        once: true,
      })
      let lastOpener = toggle

      const locale = root.dataset.locale || 'ja'
      const loadingText = root.dataset.loading || 'Thinking...'
      const errorText = root.dataset.error || 'AI assistant is unavailable.'
      const greetingText = root.dataset.greeting || ''
      const contactUrl = root.dataset.contactUrl || '/contact/'
      const emailUser = root.dataset.emailUser || ''
      const emailDomain = root.dataset.emailDomain || ''
      const directEmail =
        emailUser && emailDomain ? `${emailUser}@${emailDomain}` : ''
      const phoneDigits = (root.dataset.phoneParts || '')
        .split('|')
        .filter(Boolean)
        .join('')
      const messages = []
      let busy = false

      function track(name, params) {
        if (window.aceTrackEvent) {
          window.aceTrackEvent(name, {
            page_path: window.location.pathname,
            page_title: document.title,
            location: 'ai_chat_widget',
            ...(params || {}),
          })
        }
      }

      function scrollMessages() {
        messagesEl.scrollTop = messagesEl.scrollHeight
      }

      function renderMessage(role, text, isError) {
        const row = document.createElement('div')
        row.className = 'ac-chat__message'
        row.dataset.role = role
        if (isError) row.dataset.error = 'true'

        const bubble = document.createElement('div')
        bubble.className =
          'ac-chat__bubble' +
          (role === 'assistant' && !isError ? ' ace-chat-markdown' : '')

        if (role === 'assistant' && !isError) {
          renderMarkdownText(bubble, text)
        } else {
          bubble.textContent = text
        }

        row.appendChild(bubble)
        messagesEl.appendChild(row)
        scrollMessages()
        return row
      }

      function renderMarkdownText(container, text) {
        container.textContent = ''
        const lines = String(text || '')
          .replace(/\r\n?/g, '\n')
          .trim()
          .split('\n')

        let paragraphLines = []
        let list = null
        let listType = ''

        function flushParagraph() {
          if (paragraphLines.length === 0) return
          const paragraph = document.createElement('p')
          appendInlineMarkdown(paragraph, paragraphLines.join('\n'))
          container.appendChild(paragraph)
          paragraphLines = []
        }

        function flushList() {
          list = null
          listType = ''
        }

        function ensureList(type) {
          if (list && listType === type) return list
          flushParagraph()
          list = document.createElement(type)
          listType = type
          container.appendChild(list)
          return list
        }

        lines.forEach((line) => {
          const trimmed = line.trim()
          if (!trimmed) {
            flushParagraph()
            flushList()
            return
          }

          const unorderedMatch = trimmed.match(/^[-*+・]\s+(.+)$/)
          const orderedMatch = trimmed.match(/^\d+\.\s+(.+)$/)

          if (unorderedMatch) {
            const item = document.createElement('li')
            appendInlineMarkdown(item, unorderedMatch[1])
            ensureList('ul').appendChild(item)
            return
          }

          if (orderedMatch) {
            const item = document.createElement('li')
            appendInlineMarkdown(item, orderedMatch[1])
            ensureList('ol').appendChild(item)
            return
          }

          flushList()
          paragraphLines.push(trimmed.replace(/^#{1,3}\s+/, ''))
        })

        flushParagraph()
      }

      function appendInlineMarkdown(parent, text) {
        const pattern =
          /(\[([^\]\r\n]{1,200})\]\(\s*([^\s)]+)(?:\s+"[^"\r\n]*")?\s*\)|\*\*([^*]+)\*\*|__([^_]+)__|`([^`]+)`|\*([^*]+)\*|_([^_]+)_)/g
        let index = 0
        let match

        while ((match = pattern.exec(text)) !== null) {
          if (match.index > index) {
            parent.appendChild(
              document.createTextNode(text.slice(index, match.index)),
            )
          }

          const href = String(match[3] || '').trim()
          if (match[2] && isSafeMarkdownHref(href)) {
            const link = document.createElement('a')
            link.href = href
            link.rel = 'noopener noreferrer'
            if (/^https?:\/\//i.test(href)) {
              link.target = '_blank'
            }
            link.textContent = match[2]
            parent.appendChild(link)
          } else if (match[4] || match[5]) {
            const strong = document.createElement('strong')
            appendInlineMarkdown(strong, match[4] || match[5])
            parent.appendChild(strong)
          } else if (match[6]) {
            const code = document.createElement('code')
            code.textContent = match[6]
            parent.appendChild(code)
          } else if (match[7] || match[8]) {
            const emphasis = document.createElement('em')
            appendInlineMarkdown(emphasis, match[7] || match[8])
            parent.appendChild(emphasis)
          } else {
            parent.appendChild(document.createTextNode(match[0]))
          }

          index = pattern.lastIndex
        }

        if (index < text.length) {
          parent.appendChild(document.createTextNode(text.slice(index)))
        }
      }

      function isSafeMarkdownHref(value) {
        const href = String(value || '').trim()
        if (!href || /[\u0000-\u001f\u007f\\]/u.test(href)) return false

        if (directEmail) {
          const allowedMailto = `mailto:${directEmail}`.toLowerCase()
          const normalizedHref = href.toLowerCase()
          if (
            normalizedHref === allowedMailto ||
            normalizedHref.startsWith(`${allowedMailto}?`)
          ) {
            return true
          }
        }
        if (phoneDigits && href === `tel:${phoneDigits}`) return true

        try {
          const url = new URL(href, window.location.href)
          if (url.username || url.password) return false
          if (url.origin === window.location.origin) return true
          if (url.origin === 'https://acecore.net') return true
          if (url.origin === 'https://systems.acecore.net') return true
          if (url.origin === 'https://schools.acecore.net') {
            return true
          }
          if (url.origin === 'https://asv.acecore.net') return true
          if (url.origin === 'https://asv-wiki.acecore.net') return true
          if (url.origin === 'https://world-foundation.acecore.net') {
            return true
          }
          if (url.href === 'https://lin.ee/DjIrdqj') return true
        } catch {
          return false
        }

        return false
      }

      function addMessage(role, content, options) {
        messages.push({ role, content })
        return renderMessage(role, content, options?.isError)
      }

      function updateStreamingMessage(row, text, complete = false) {
        const bubble = row?.querySelector('.ace-chat-markdown')
        if (!bubble) return
        if (complete) {
          renderMarkdownText(bubble, text)
        } else {
          bubble.textContent = text
        }
        scrollMessages()
      }

      async function readChatResponse(response, onDelta) {
        const contentType = String(response.headers.get('Content-Type') || '')
          .split(';', 1)[0]
          .trim()
          .toLowerCase()
        if (contentType !== 'text/event-stream') {
          return response.json().catch(() => null)
        }
        if (!response.body) throw new Error(errorText)

        const reader = response.body.getReader()
        const decoder = new TextDecoder()
        let buffer = ''
        let finalPayload = null

        function consumeEvent(block) {
          let event = 'message'
          const data = []
          String(block)
            .split(/\r?\n/u)
            .forEach((line) => {
              if (line.startsWith('event:')) {
                event = line.slice(6).trim()
              } else if (line.startsWith('data:')) {
                data.push(line.slice(5).trimStart())
              }
            })
          if (data.length === 0) return

          let payload
          try {
            payload = JSON.parse(data.join('\n'))
          } catch {
            throw new Error(errorText)
          }
          if (event === 'delta') {
            if (typeof payload?.text !== 'string') throw new Error(errorText)
            onDelta(payload.text)
          } else if (event === 'complete' || event === 'error') {
            finalPayload = payload
          }
        }

        function consumeBufferedEvents(flush = false) {
          while (true) {
            const boundary = /\r?\n\r?\n/u.exec(buffer)
            if (!boundary) break
            consumeEvent(buffer.slice(0, boundary.index))
            buffer = buffer.slice(boundary.index + boundary[0].length)
          }
          if (flush && buffer.trim()) {
            consumeEvent(buffer)
            buffer = ''
          }
        }

        try {
          while (true) {
            const { done, value } = await reader.read()
            if (done) break
            buffer += decoder.decode(value, { stream: true })
            consumeBufferedEvents()
          }
          buffer += decoder.decode()
          consumeBufferedEvents(true)
        } finally {
          reader.releaseLock()
        }

        if (!finalPayload) throw new Error(errorText)
        return finalPayload
      }

      function openChat(opener = toggle) {
        lastOpener = opener
        panel.classList.remove('hidden')
        panel.classList.add('flex')
        toggle.setAttribute('aria-expanded', 'true')
        lastOpener.setAttribute('aria-expanded', 'true')
        root.classList.add('is-open')
        if (messages.length === 0 && greetingText) {
          addMessage('assistant', greetingText)
          messagesEl.scrollTop = 0
        }
        window.setTimeout(() => input.focus(), 0)
        track('ai_chat_open')
      }

      function closeChat() {
        panel.classList.add('hidden')
        panel.classList.remove('flex')
        toggle.setAttribute('aria-expanded', 'false')
        lastOpener.setAttribute('aria-expanded', 'false')
        root.classList.remove('is-open')
        lastOpener.focus()
      }

      async function sendQuestion(text) {
        if (busy) return
        const trimmed = text.trim()
        if (!trimmed) {
          input.focus()
          return
        }

        input.value = ''
        addMessage('user', trimmed)
        const loadingRow = renderMessage('assistant', loadingText, false)
        busy = true
        panel.setAttribute('aria-busy', 'true')
        submit.disabled = true
        input.disabled = true
        root
          .querySelectorAll('[data-ace-chat-prompt]')
          .forEach((button) => (button.disabled = true))

        try {
          let streamedAnswer = ''
          const response = await fetch('/api/ai-chat', {
            method: 'POST',
            headers: {
              Accept: 'text/event-stream',
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              locale,
              messages: messages.slice(-8),
              question: trimmed,
            }),
          })
          const payload = await readChatResponse(response, (delta) => {
            streamedAnswer += delta
            updateStreamingMessage(loadingRow, streamedAnswer)
          })
          if (!response.ok || !payload?.ok) {
            throw new Error(payload?.answer || errorText)
          }
          const answer = payload.answer || errorText
          messages.push({ role: 'assistant', content: answer })
          updateStreamingMessage(loadingRow, answer, true)
          track('ai_chat_answer')
        } catch (error) {
          loadingRow.remove()
          addMessage('assistant', error.message || errorText, { isError: true })
        } finally {
          busy = false
          panel.removeAttribute('aria-busy')
          submit.disabled = false
          input.disabled = false
          root
            .querySelectorAll('[data-ace-chat-prompt]')
            .forEach((button) => (button.disabled = false))
          if (!panel.classList.contains('hidden')) input.focus()
        }
      }

      toggle.addEventListener('click', () => {
        if (panel.classList.contains('hidden')) {
          openChat()
        } else {
          closeChat()
        }
      })

      root.querySelectorAll('[data-ace-chat-close]').forEach((button) => {
        button.addEventListener('click', closeChat)
      })

      document.addEventListener(
        'click',
        (event) => {
          const target = event.target
          if (!(target instanceof Element)) return
          const opener = target.closest('[data-ace-chat-open]')
          if (opener) {
            event.preventDefault()
            openChat(opener)
          }
        },
        { signal: listeners.signal },
      )

      root.querySelectorAll('[data-ace-chat-prompt]').forEach((button) => {
        button.addEventListener('click', () => {
          if (!(button instanceof HTMLButtonElement)) return
          input.value = (button.textContent || '').trim()
          void sendQuestion(input.value)
        })
      })

      form.addEventListener('submit', (event) => {
        event.preventDefault()
        void sendQuestion(input.value)
      })

      input.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {
          event.preventDefault()
          void sendQuestion(input.value)
        }
      })

      document.addEventListener(
        'keydown',
        (event) => {
          if (
            event.key === 'Escape' &&
            !event.isComposing &&
            !panel.classList.contains('hidden')
          ) {
            closeChat()
          }
        },
        { signal: listeners.signal },
      )

      root.querySelectorAll('a[href]').forEach((link) => {
        link.addEventListener('click', () => {
          track('ai_chat_contact_link', {
            destination: link.getAttribute('href') || contactUrl,
          })
        })
      })
    }

    initAceAiChat()
    document.addEventListener('astro:page-load', initAceAiChat)
  })()
</script>

<style is:global>
  #ace-ai-chat .ace-chat-markdown {
    line-height: 1.65;
  }

  #ace-ai-chat .ace-chat-markdown p + p,
  #ace-ai-chat .ace-chat-markdown p + ul,
  #ace-ai-chat .ace-chat-markdown p + ol,
  #ace-ai-chat .ace-chat-markdown ul + p,
  #ace-ai-chat .ace-chat-markdown ol + p {
    margin-top: 0.5rem;
  }

  #ace-ai-chat .ace-chat-markdown ul,
  #ace-ai-chat .ace-chat-markdown ol {
    margin-block: 0.25rem;
    padding-left: 1.25rem;
  }

  #ace-ai-chat .ace-chat-markdown ul {
    list-style: disc;
  }

  #ace-ai-chat .ace-chat-markdown ol {
    list-style: decimal;
  }

  #ace-ai-chat .ace-chat-markdown li + li {
    margin-top: 0.25rem;
  }

  #ace-ai-chat .ace-chat-markdown strong {
    color: rgb(15 23 42);
    font-weight: 700;
  }

  #ace-ai-chat .ace-chat-markdown a {
    color: rgb(37 99 235);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  #ace-ai-chat .ace-chat-markdown code {
    border-radius: 0.25rem;
    background: rgb(226 232 240);
    padding: 0.05rem 0.25rem;
    font-size: 0.92em;
  }
</style>
