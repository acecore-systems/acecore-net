---
import Icon from './Icon.astro'
import { t, getLocalizedUrl, type Locale } from '../i18n'
import { SITE } from '../data/site'
import { getSpecialistUrl } from '../utils/specialist-url'
interface Props {
  locale: Locale
  anchors?: boolean
}
const { locale, anchors = true } = Astro.props
const offerings = [
  {
    key: 'development',
    icon: 'code-xml',
    group: 'systems',
    href: getSpecialistUrl(
      SITE.social.systems,
      locale,
      '/services/development/',
    ),
  },
  {
    key: 'advisor',
    icon: 'messages-square',
    group: 'systems',
    href: getSpecialistUrl(
      SITE.social.systems,
      locale,
      '/services/it-advisor/',
    ),
  },
  {
    key: 'acestudio',
    icon: 'palette',
    group: 'community',
    href: getLocalizedUrl('/acestudio/', locale),
    internal: true,
  },
  {
    key: 'aceserver',
    icon: 'gamepad-2',
    group: 'community',
    href: getSpecialistUrl(SITE.social.aceserver, locale),
  },
  {
    key: 'store',
    icon: 'shopping-bag',
    group: 'community',
    href: SITE.social.store,
  },
]
---

<div
  class="service-offerings divide-y divide-slate-200 border-y border-slate-200"
>
  {
    offerings.map((item) => (
      <article
        id={
          !anchors
            ? undefined
            : ['aceserver', 'store'].includes(item.key)
              ? item.key + '-service'
              : item.key
        }
      >
        {anchors && item.key === 'aceserver' && <span id="community" />}
        <a
          href={item.href}
          target={item.internal ? undefined : '_blank'}
          rel={item.internal ? undefined : 'noopener noreferrer'}
          class="group grid gap-2 py-5 no-underline transition-colors hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-500 md:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)_auto] md:items-center md:gap-6"
          data-ga-event="cta_click"
          data-ga-label={t(locale, 'pages.services.' + item.key + 'Title')}
          data-ga-location="service_list"
          data-ga-destination={item.href}
        >
          <div>
            <h3 class="text-base font-700 text-slate-900 group-hover:text-brand-600">
              {t(locale, 'pages.services.' + item.key + 'Title')}
            </h3>
            {item.key === 'acestudio' && (
              <span class="mt-1 block text-xs text-slate-500">
                {t(locale, 'pages.services.acestudioStatus')}
              </span>
            )}
          </div>
          <p class="text-sm leading-relaxed text-slate-600">
            {t(locale, 'pages.services.' + item.key + 'Description')}
          </p>
          <span class="inline-flex items-center gap-2 text-sm font-600 text-brand-600">
            {t(locale, 'pages.services.detailsCta')}
            <Icon name="arrow-right" class="text-sm" />
            {!item.internal && (
              <span class="sr-only">{t(locale, 'common.opensInNewTab')}</span>
            )}
          </span>
        </a>
      </article>
    ))
  }
</div>
