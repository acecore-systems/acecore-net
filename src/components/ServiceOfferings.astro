---
import Icon from './Icon.astro'
import { t, getLocalizedUrl, type Locale } from '../i18n'
import { SITE } from '../data/site'
import { getSchoolsUrl } from '../utils/schools-url'
import { getSpecialistUrl } from '../utils/specialist-url'

interface Props {
  locale: Locale
  compact?: boolean
}
const { locale, compact = false } = Astro.props
const offerings = [
  {
    key: 'development',
    owner: 'Acecore Systems',
    href: getSpecialistUrl(
      SITE.social.systems,
      locale,
      '/services/development/',
    ),
  },
  {
    key: 'advisor',
    owner: 'Acecore Systems',
    href: getSpecialistUrl(
      SITE.social.systems,
      locale,
      '/services/it-advisor/',
    ),
  },
  {
    key: 'learning',
    owner: 'Acecore Schools',
    href: getSchoolsUrl('/learning/'),
  },
  {
    key: 'aceserver',
    owner: 'Aceserver',
    href: getSpecialistUrl(SITE.social.aceserver, locale),
  },
  { key: 'store', owner: 'Acecore Store', href: SITE.social.store },
]
---

<div
  class:list={[
    'grid gap-4',
    compact ? 'sm:grid-cols-2 lg:grid-cols-3' : 'lg:grid-cols-2',
  ]}
>
  {
    offerings.map((item) => (
      <article
        id={
          compact
            ? undefined
            : item.key === 'aceserver' || item.key === 'store'
              ? `${item.key}-service`
              : item.key
        }
        class="ac-card flex scroll-mt-28 flex-col p-6"
      >
        {item.owner !== t(locale, `pages.services.${item.key}Title`) && (
          <p class="mb-2 text-xs font-700 tracking-wide text-slate-500">
            {item.owner}
          </p>
        )}
        <h3 class="text-lg ac-heading">
          {t(locale, `pages.services.${item.key}Title`)}
        </h3>
        {!compact && (
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            {t(locale, `pages.services.${item.key}Description`)}
          </p>
        )}
        <a
          class="ac-link mt-auto inline-flex items-center gap-2 pt-5"
          href={
            compact
              ? getLocalizedUrl(
                  `/services/#${item.key === 'aceserver' || item.key === 'store' ? `${item.key}-service` : item.key}`,
                  locale,
                )
              : item.href
          }
          target={compact ? undefined : '_blank'}
          rel={compact ? undefined : 'noopener noreferrer'}
        >
          {t(locale, 'pages.services.viewService')}
          <Icon name={compact ? 'arrow-right' : 'arrow-up-right'} />
          {!compact && (
            <span class="sr-only">{t(locale, 'common.opensInNewTab')}</span>
          )}
        </a>
      </article>
    ))
  }
</div>
