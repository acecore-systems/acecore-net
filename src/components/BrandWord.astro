---
interface Props {
  word: string
  kind: 'corporate' | 'service'
}
const { word, kind } = Astro.props
const index = kind === 'corporate' ? (word === 'Acecore' ? 3 : -1) : 0
const classes =
  kind === 'corporate'
    ? 'brand-word brand-word-corporate'
    : 'brand-word brand-word-' + word.toLowerCase()
---

<span class={classes}>
  {index < 0 ? (
    word
  ) : (
    <>
      {word.slice(0, index)}
      <span class="brand-initial">{word[index]}</span>
      {word.slice(index + 1)}
    </>
  )}
</span>
