---
import { SITE } from '../data/site'
import { t, getLocalizedUrl, getLocaleFromUrl, type Locale } from '../i18n'
import { getSchoolsUrl } from '../utils/schools-url'
import { getSpecialistUrl } from '../utils/specialist-url'

interface Props {
  locale?: Locale
}

const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url)
const currentYear = new Date().getFullYear()
const u = (path: string) => getLocalizedUrl(path, locale)
const siteLinks = [
  { href: u('/'), label: t(locale, 'nav.home') },
  { href: u('/services/'), label: t(locale, 'nav.services') },
  { href: u('/pricing/'), label: t(locale, 'nav.pricing') },
  { href: u('/about/'), label: t(locale, 'nav.about') },
  { href: u('/blog/'), label: t(locale, 'nav.blog') },
  { href: u('/contact/'), label: t(locale, 'nav.contact') },
  { href: u('/privacy/'), label: t(locale, 'footer.privacy') },
]
const businessLinks = [
  {
    href: getSpecialistUrl(SITE.social.systems, locale),
    label: 'Acecore Systems',
  },
  { href: getSchoolsUrl(), label: 'Acecore Schools' },
  {
    href: getSpecialistUrl(SITE.social.aceserver, locale),
    label: 'Aceserver',
  },
]
---

<footer class="bg-slate-900 text-slate-300">
  <div class="ac-container py-14">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-[1.2fr_1fr_1fr]">
      <div>
        <h3 class="mb-3 text-lg font-700 text-white">Acecore</h3>
        <p class="text-sm leading-relaxed">
          {t(locale, 'footer.tagline')}<br />
          {t(locale, 'footer.description')}
        </p>
      </div>

      <div>
        <h3 class="mb-3 text-lg font-700 text-white">
          {t(locale, 'footer.sitemap')}
        </h3>
        <ul class="m-0 list-none p-0 text-sm" role="list">
          {
            siteLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-10 items-center rounded-md px-2 -mx-2 text-slate-300 no-underline transition-colors hover:bg-white/5 hover:text-white"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="mb-3 text-lg font-700 text-white">
          {t(locale, 'footer.relatedLinks')}
        </h3>
        <ul class="m-0 list-none p-0 text-sm" role="list">
          {
            businessLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-10 items-center rounded-md px-2 -mx-2 text-slate-300 no-underline transition-colors hover:bg-white/5 hover:text-white"
                  data-ga-event="external_link_click"
                  data-ga-label={`footer_${link.label.toLowerCase().replaceAll(' ', '_')}`}
                  data-ga-location="footer"
                  data-ga-destination={link.href}
                >
                  {link.label}
                  <span class="sr-only">
                    {t(locale, 'common.opensInNewTab')}
                  </span>
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={SITE.social.x}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-10 items-center rounded-md px-2 -mx-2 text-slate-300 no-underline transition-colors hover:bg-white/5 hover:text-white"
              data-ga-event="external_link_click"
              data-ga-label="footer_x"
              data-ga-location="footer"
              data-ga-destination={SITE.social.x}
            >
              X
              <span class="sr-only">{t(locale, 'common.opensInNewTab')}</span>
            </a>
          </li>
          <li>
            <a
              href={SITE.social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-10 items-center rounded-md px-2 -mx-2 text-slate-300 no-underline transition-colors hover:bg-white/5 hover:text-white"
              data-ga-event="external_link_click"
              data-ga-label="footer_github"
              data-ga-location="footer"
              data-ga-destination={SITE.social.github}
            >
              GitHub
              <span class="sr-only">{t(locale, 'common.opensInNewTab')}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-slate-700 pt-8 text-center text-sm">
      <p>&copy;{currentYear} Acecore</p>
    </div>
  </div>
</footer>
