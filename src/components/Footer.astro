---
import { SITE } from '../data/site'
import { getLocalizedUrl, getLocaleFromUrl, t, type Locale } from '../i18n'
import { getSchoolsUrl } from '../utils/schools-url'
import { getSpecialistUrl } from '../utils/specialist-url'
interface Props {
  locale?: Locale
}
const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url)
const u = (path: string) => getLocalizedUrl(path, locale)
const siteLinks = [
  { href: u('/services/'), label: t(locale, 'nav.services') },
  { href: u('/about/'), label: t(locale, 'nav.about') },
  { href: u('/blog/'), label: t(locale, 'nav.blog') },
  { href: u('/contact/'), label: t(locale, 'nav.contact') },
]
const related = [
  {
    href: getSpecialistUrl(SITE.social.systems, locale),
    label: 'Acecore Systems',
  },
  { href: getSchoolsUrl(), label: 'Acecore Schools' },
  { href: getSpecialistUrl(SITE.social.aceserver, locale), label: 'Aceserver' },
  { href: SITE.social.store, label: 'Acecore Store' },
  { href: SITE.social.x, label: 'X' },
  { href: SITE.social.github, label: 'GitHub' },
]
---

<footer class="site-footer text-sm text-slate-200">
  <div class="ac-container py-12">
    <div
      class="flex flex-col justify-between gap-5 md:flex-row md:items-center"
    >
      <a
        href={u('/')}
        class="inline-flex items-center gap-2 text-lg font-700 text-white no-underline"
      >
        <img
          src="/favicon.svg"
          alt="Acecore"
          width="32"
          height="32"
          class="rounded-full bg-white p-1"
        /><span aria-hidden="true">Acecore</span>
      </a>
      <nav
        aria-label={t(locale, 'footer.sitemap')}
        class="flex flex-wrap gap-x-6 gap-y-1"
      >
        {
          siteLinks.map((link) => (
            <a
              class="inline-flex min-h-11 items-center hover:text-white hover:underline"
              href={link.href}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
    <div
      class="mt-5 flex flex-col gap-3 border-t border-white/20 pt-5 md:flex-row md:items-start md:gap-8"
    >
      <p class="shrink-0 leading-10 text-xs text-slate-300">
        {t(locale, 'footer.relatedLinks')}
      </p>
      <ul class="flex flex-wrap gap-x-5 gap-y-1">
        {
          related.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-10 items-center hover:text-white hover:underline"
                data-ga-event="external_link_click"
                data-ga-label={`footer_${link.label.toLowerCase().replaceAll(' ', '_')}`}
                data-ga-location="footer"
                data-ga-destination={link.href}
              >
                {link.label}
                <span class="sr-only">{t(locale, 'common.opensInNewTab')}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div
      class="mt-5 flex flex-col justify-between gap-4 text-xs text-slate-300 sm:flex-row sm:items-center"
    >
      <p>&copy;{new Date().getFullYear()} {SITE.legalName}</p>
      <div class="flex flex-wrap gap-x-5 gap-y-1">
        <a
          href={u('/privacy/')}
          class="inline-flex min-h-10 items-center hover:underline"
          >{t(locale, 'footer.privacy')}</a
        >
        <a
          href={u('/terms/')}
          class="inline-flex min-h-10 items-center hover:underline"
          >{t(locale, 'footer.terms')}</a
        >
      </div>
    </div>
  </div>
</footer>
