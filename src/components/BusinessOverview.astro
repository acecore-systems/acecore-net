---
import Icon from './Icon.astro'
import { t, type Locale } from '../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const departments = [
  { key: 'systems', icon: 'code-xml' },
  { key: 'schools', icon: 'graduation-cap' },
  { key: 'design', icon: 'palette' },
]
---

<figure class="business-overview w-full rounded-lg border border-brand-200 bg-brand-50/90 p-5 shadow-[0_18px_38px_rgba(15,35,56,0.06)] sm:p-7">
  <figcaption class="mb-5 text-center text-xs font-700 text-brand-700">
    {t(locale, 'pages.services.overviewCaption')}
  </figcaption>
  <div class="overview-root relative mx-auto max-w-sm rounded-lg border border-brand-200 bg-white px-5 py-5 text-center">
    <p class="mb-2 text-lg font-800 tracking-wide text-slate-950">Acecore</p>
    <p class="text-sm font-700 leading-relaxed text-brand-700">
      {t(locale, 'pages.home.heroTitle')}
    </p>
  </div>
  <ul class="overview-branches relative m-0 mt-8 grid list-none grid-cols-1 gap-4 p-0 pl-5 sm:grid-cols-3 sm:gap-3 sm:pl-0">
    {departments.map(({ key, icon }) => (
      <li class="overview-branch relative min-w-0">
        <a
          href={`#${key}`}
          class="relative z-10 flex h-full min-h-11 items-center gap-3 rounded-lg border border-brand-200 bg-white px-4 py-4 no-underline transition-colors hover:border-brand-400 hover:bg-brand-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 sm:flex-col sm:px-3 sm:text-center"
        >
          <Icon name={icon} class="shrink-0 text-2xl text-brand-600" />
          <span class="min-w-0">
            <span class="block text-sm font-800 leading-snug text-slate-950">
              {t(locale, `pages.services.${key}Title`)}
            </span>
            <span class="mt-2 block text-xs leading-relaxed text-slate-600">
              {t(locale, `pages.services.${key}Role`)}
            </span>
          </span>
          <Icon
            name="arrow-down"
            class="ml-auto shrink-0 text-sm text-brand-600 sm:mx-auto sm:mt-auto"
          />
        </a>
      </li>
    ))}
  </ul>
</figure>

<style>
  .overview-branches::before {
    position: absolute;
    top: -2rem;
    left: 0;
    width: 50%;
    height: calc(100% - 1rem);
    border-top: 1px solid var(--color-brand-300);
    border-left: 1px solid var(--color-brand-300);
    content: '';
  }

  .overview-branch::before {
    position: absolute;
    top: 50%;
    left: -1.25rem;
    width: 1.25rem;
    border-top: 1px solid var(--color-brand-300);
    content: '';
  }

  @media (min-width: 640px) {
    .overview-root::after {
      position: absolute;
      bottom: -1rem;
      left: 50%;
      height: 1rem;
      border-left: 1px solid var(--color-brand-300);
      content: '';
    }

    .overview-branches::before {
      top: -1rem;
      left: 16.6667%;
      width: 66.6667%;
      height: 0;
      border-left: 0;
    }

    .overview-branch::before {
      top: -1rem;
      left: 50%;
      width: 0;
      height: 1rem;
      border-top: 0;
      border-left: 1px solid var(--color-brand-300);
    }
  }
</style>
