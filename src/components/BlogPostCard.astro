---
import {
  optimizeImage,
  generateSrcSet,
  resolveImageSource,
} from '../utils/image'
import {
  t,
  formatDate,
  getLocaleFromUrl,
  getLocalizedUrl,
  type Locale,
} from '../i18n'
import { getBaseSlug, getLocalizedAuthor } from '../utils/blog-i18n'
import { getAllAuthors, findAuthorById } from '../utils/authors'
import { getAllTags, getLocalizedTagName } from '../utils/tags'
import Icon from './Icon.astro'

interface Props {
  post: {
    id: string
    data: {
      title: string
      description: string
      date: Date
      image?: string
      uploadedImage?: string
      author?: string
      tags?: string[]
    }
  }
  locale?: Locale
}

const { post } = Astro.props
const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url)
const baseSlug = getBaseSlug(post.id)
const postImage = resolveImageSource(post.data.uploadedImage, post.data.image)
const authors = await getAllAuthors()
const tags = await getAllTags()
const rawAuthor = findAuthorById(authors, post.data.author)
const author = rawAuthor ? getLocalizedAuthor(rawAuthor, locale) : null
const cardImageWidths = [320, 640, 960, 1200]
const cardImageOptions = { aspectRatio: 16 / 9, quality: 80 }
---

<article class="news-row group">
  <a
    href={getLocalizedUrl('/blog/' + baseSlug + '/', locale)}
    class="news-row-main-link"
    aria-label={post.data.title}
  ></a>
  {postImage && (
    <div class="news-row-image">
      <img
        src={optimizeImage(postImage, { width: 960, height: 540, quality: 80 })}
        srcset={generateSrcSet(postImage, cardImageWidths, cardImageOptions)}
        sizes="(min-width: 1280px) 360px, (min-width: 768px) 28vw, calc(100vw - 48px)"
        alt={post.data.title}
        width="960"
        height="540"
        decoding="async"
        loading="lazy"
      />
    </div>
  )}
  <div class="news-row-copy">
    <div class="news-row-meta">
      <time datetime={post.data.date.toISOString()}>
        {formatDate(post.data.date, locale)}
      </time>
      {post.data.author && (
        <a
          href={getLocalizedUrl(
            '/blog/authors/' + post.data.author + '/',
            locale,
          )}
        >
          by {author?.name || post.data.author}
        </a>
      )}
    </div>
    <h2>{post.data.title}</h2>
    <p>{post.data.description}</p>
    {post.data.tags && (
      <div class="news-row-tags">
        {post.data.tags.map((tag) => (
          <a href={getLocalizedUrl('/blog/tags/' + tag + '/', locale)}>
            {getLocalizedTagName(tags, tag, locale)}
          </a>
        ))}
      </div>
    )}
    <span class="news-row-read-more">{t(locale, 'blog.readMore')}</span>
  </div>
  <span class="ac-arrow-circle" aria-hidden="true">
    <Icon name="arrow-right" />
  </span>
</article>
