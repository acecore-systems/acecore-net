---
import ServiceCard from './ServiceCard.astro'
import { t, getLocalizedUrl, type Locale } from '../i18n'
interface Props {
  locale: Locale
  overview?: boolean
}
const { locale, overview = false } = Astro.props
const departments = [
  {
    key: 'systems',
    icon: 'code-xml',
    tone: 'brand' as const,
    destination: 'development',
  },
  {
    key: 'schools',
    icon: 'graduation-cap',
    tone: 'amber' as const,
    destination: 'learning',
  },
  {
    key: 'design',
    icon: 'palette',
    tone: 'emerald' as const,
    destination: 'design-details',
  },
]
---

<ul
  class="department-list m-0 grid list-none grid-cols-1 gap-6 p-0 lg:grid-cols-3"
  role="list"
>
  {
    departments.map(({ key, icon, tone, destination }) => (
      <li id={overview ? key : undefined}>
        <ServiceCard
          title={t(locale, 'pages.services.' + key + 'Title')}
          description={t(locale, 'pages.services.' + key + 'Role')}
          href={
            overview
              ? '#' + destination
              : getLocalizedUrl('/services/#' + key, locale)
          }
          icon={icon}
          tone={tone}
          locale={locale}
        >
          {key === 'design' && (
            <span class="ac-chip mb-3 text-xs">
              {t(locale, 'pages.services.designStatus')}
            </span>
          )}
        </ServiceCard>
      </li>
    ))
  }
</ul>
