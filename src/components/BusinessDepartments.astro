---
import Icon from './Icon.astro'
import { t, getLocalizedUrl, type Locale } from '../i18n'
import { SITE } from '../data/site'
import { getSchoolsUrl } from '../utils/schools-url'
import { getSpecialistUrl } from '../utils/specialist-url'
interface Props {
  locale: Locale
  overview?: boolean
}
const { locale, overview = false } = Astro.props
const departments = [
  {
    key: 'systems',
    icon: 'code-xml',
    tone: 'brand' as const,
    href: getSpecialistUrl(SITE.social.systems, locale),
  },
  {
    key: 'schools',
    icon: 'graduation-cap',
    tone: 'amber' as const,
    href: getSchoolsUrl(),
  },
  {
    key: 'design',
    icon: 'palette',
    tone: 'emerald' as const,
    href: overview
      ? getLocalizedUrl('/contact/', locale)
      : getLocalizedUrl('/services/#design-details', locale),
  },
]
---

<ul
  class="department-list m-0 grid list-none grid-cols-1 gap-8 p-0 lg:grid-cols-3"
  role="list"
>
  {
    departments.map(({ key, href }) => (
      <li id={overview ? key : undefined}>
        {overview && key === 'design' && <span id="design-details" />}
        <a
          href={href}
          target={key === 'design' ? undefined : '_blank'}
          rel={key === 'design' ? undefined : 'noopener noreferrer'}
          class="group block h-full border-t-2 border-brand-200 pt-5 no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-500"
        >
          <h3 class="flex items-center justify-between gap-3 text-lg font-800 text-slate-900 group-hover:text-brand-600">
            {t(locale, 'pages.services.' + key + 'Title')}
            <Icon
              name="arrow-up-right"
              class="shrink-0 text-base text-brand-500"
            />
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            {t(locale, 'pages.services.' + key + 'Description')}
          </p>
          {key === 'design' && (
            <span class="mt-2 block text-xs text-slate-500">
              {t(locale, 'pages.services.designStatus')}
            </span>
          )}
          {key !== 'design' && (
            <span class="sr-only">{t(locale, 'common.opensInNewTab')}</span>
          )}
        </a>
      </li>
    ))
  }
</ul>
