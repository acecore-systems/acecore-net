---
import Icon from './Icon.astro'
import { t, getLocalizedUrl, type Locale } from '../i18n'
interface Props {
  locale: Locale
  overview?: boolean
}
const { locale, overview = false } = Astro.props
const departments = [
  { key: 'systems', icon: 'code-2', destination: 'development' },
  { key: 'schools', icon: 'book-open', destination: 'learning' },
  { key: 'design', icon: 'pen-tool', destination: 'design-details' },
]
---

<ul class="department-list">
  {
    departments.map(({ key, icon, destination }) => (
      <li
        class={`department department-${key}`}
        id={overview ? key : undefined}
      >
        <a
          href={
            overview
              ? `#${destination}`
              : getLocalizedUrl(`/services/#${key}`, locale)
          }
          class="department-link"
        >
          <div class="department-copy">
            <Icon name={icon} class="department-icon" />
            <h3>{t(locale, `pages.services.${key}Title`)}</h3>
            <p>{t(locale, `pages.services.${key}Role`)}</p>
            {key === 'design' && (
              <span class="department-status">
                {t(locale, 'pages.services.designStatus')}
              </span>
            )}
            <Icon name="arrow-right" class="department-arrow" />
          </div>
        </a>
      </li>
    ))
  }
</ul>
