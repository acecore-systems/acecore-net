---
import BrandImage from './BrandImage.astro'
import Icon from './Icon.astro'
import { t, type Locale } from '../i18n'
import { SITE } from '../data/site'
import { getSchoolsUrl } from '../utils/schools-url'
import { getSpecialistUrl } from '../utils/specialist-url'
interface Props {
  locale: Locale
}
const { locale } = Astro.props
const departments = [
  {
    key: 'systems',
    image: 'systems' as const,
    href: getSpecialistUrl(SITE.social.systems, locale),
  },
  { key: 'schools', image: 'schools' as const, href: getSchoolsUrl() },
  {
    key: 'design',
    image: 'designs' as const,
    href: getSpecialistUrl(SITE.social.designs, locale, '/'),
  },
]
---

<ul class="department-list">
  {departments.map(({ key, image, href }) => (
    <li id={key}>
      <a
        class="department-row"
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        data-ga-event="cta_click"
        data-ga-label={t(locale, 'pages.services.' + key + 'Title')}
        data-ga-location="service_card"
        data-ga-destination={href}
      >
        <BrandImage
          name={image}
          alt={t(locale, 'pages.services.' + key + 'ImgAlt')}
          sizes="(min-width: 1280px) 340px, (min-width: 768px) 28vw, calc(100vw - 48px)"
        />
        <div class="department-copy">
          <h3>{t(locale, 'pages.services.' + key + 'Title')}</h3>
          <p>{t(locale, 'pages.services.' + key + 'Description')}</p>
          {key === 'design' && (
            <>
              <p id="design-details" class="department-status">
                {t(locale, 'pages.services.designStatus')}
              </p>
              <p class="department-note">
                {t(locale, 'pages.services.designNote')}
              </p>
            </>
          )}
          <span class="department-link">
            {t(locale, 'pages.services.detailsCta')}
            <span class="ac-arrow-circle" aria-hidden="true">
              <Icon name="arrow-up-right" />
            </span>
          </span>
        </div>
        <span class="sr-only">{t(locale, 'common.opensInNewTab')}</span>
      </a>
    </li>
  ))}
</ul>
<p class="mt-5 text-sm ac-muted">
  {t(locale, 'pages.services.departmentImagesNote')}
</p>
