---
import Icon from './Icon.astro'
import { t, getLocalizedUrl, type Locale } from '../i18n'
interface Props {
  locale: Locale
}
const { locale } = Astro.props
---

<ul class="department-list divide-y divide-slate-200">
  {
    ['systems', 'schools', 'design'].map((key) => (
      <li>
        <a
          href={getLocalizedUrl(`/services/#${key}`, locale)}
          class="department-link"
        >
          <div>
            <h3>{t(locale, `pages.services.${key}Title`)}</h3>
            <p>{t(locale, `pages.services.${key}Role`)}</p>
            {key === 'design' && (
              <span class="mt-2 block text-xs text-slate-500">
                {t(locale, 'pages.services.designStatus')}
              </span>
            )}
          </div>
          <Icon name="arrow-right" class="shrink-0 text-xl text-brand-600" />
        </a>
      </li>
    ))
  }
</ul>
