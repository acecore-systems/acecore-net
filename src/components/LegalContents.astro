---
import { t, type Locale } from '../i18n'

interface Props {
  locale: Locale
  items: { id: string; label: string; lang?: string }[]
}

const { locale, items } = Astro.props
---

<details
  class="mb-8 rounded-lg border border-slate-200 bg-slate-50 px-5 py-3"
  data-pagefind-ignore
>
  <summary class="min-h-11 cursor-pointer py-3 text-sm font-700 text-slate-800">
    {t(locale, 'common.pageContents')}
  </summary>
  <nav aria-label={t(locale, 'common.pageContents')}>
    <ol class="mb-3 list-decimal space-y-1 pl-5 text-sm">
      {items.map(({ id, label, lang }) => (
        <li>
          <a href={`#${id}`} lang={lang} class="ac-link inline-block py-2">
            {label}
          </a>
        </li>
      ))}
    </ol>
  </nav>
</details>
