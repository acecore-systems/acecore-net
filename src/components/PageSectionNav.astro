---
import Icon from './Icon.astro'
import { t, type Locale } from '../i18n'

interface Props {
  locale: Locale
  items: { href: string; label: string }[]
}

const { locale, items } = Astro.props
---

<nav
  class="page-section-nav ac-surface mb-10 p-4 sm:p-5"
  aria-label={t(locale, 'common.pageContents')}
>
  <p class="mb-3 text-xs font-700 text-slate-500">
    {t(locale, 'common.pageContents')}
  </p>
  <ul class="m-0 grid list-none grid-cols-1 gap-2 p-0 sm:grid-cols-2 lg:flex lg:flex-wrap">
    {items.map(({ href, label }) => (
      <li class="min-w-0">
        <a
          href={href}
          class="flex min-h-11 items-center justify-between gap-3 rounded-md border border-brand-100 bg-brand-50/70 px-4 py-3 text-sm font-700 text-brand-700 no-underline transition-colors hover:border-brand-300 hover:bg-brand-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2"
        >
          <span>{label}</span>
          <Icon name="arrow-down" class="shrink-0 text-base" />
        </a>
      </li>
    ))}
  </ul>
</nav>
