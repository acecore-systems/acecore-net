---
import BrandName from './BrandName.astro'
import Icon from './Icon.astro'
import { t } from '../i18n/utils'
import type { Locale } from '../i18n'
interface Props {
  icon: string
  title: string
  description: string
  linkLabel?: string
  href?: string
  locale?: Locale
  tone?: 'brand' | 'emerald' | 'amber' | 'slate'
}
const { icon, title, description, href, linkLabel, locale = 'ja' } = Astro.props
const Tag = href ? 'a' : 'div'
const external = href?.startsWith('http')
---

<Tag
  {...(href ? { href } : {})}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
  class="service-row"
  {...(href
    ? {
        'data-ga-event': 'cta_click',
        'data-ga-label': title,
        'data-ga-location': 'service_card',
        'data-ga-destination': href,
      }
    : {})}
>
  <span class="service-row-icon" aria-hidden="true">
    <Icon name={icon} />
  </span>
  <div class="min-w-0 flex-1">
    <h3>
      <BrandName name={title} />
    </h3>
    <slot />
    <p>{description}</p>
    {linkLabel && <span class="service-row-label">{linkLabel}</span>}
  </div>
  {href && (
    <span class="ac-arrow-circle" aria-hidden="true">
      <Icon name={external ? 'arrow-up-right' : 'arrow-right'} />
    </span>
  )}
  {external && <span class="sr-only">{t(locale, 'common.opensInNewTab')}</span>}
</Tag>
