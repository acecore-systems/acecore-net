---
import Icon from './Icon.astro'
import { t, getLocalizedUrl, getLocaleFromUrl, type Locale } from '../i18n'
interface Props {
  title: string
  subtitle?: string
  titleLines?: string[]
  showCTA?: boolean
  locale?: Locale
}
const { title, subtitle, titleLines, showCTA = false } = Astro.props
const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url)
const u = (path: string) => getLocalizedUrl(path, locale)
---

<section class:list={['page-heading', { 'page-heading-home': showCTA }]}>
  <div class="ac-container">
    <h1>
      {
        titleLines?.length
          ? titleLines.map((line) => <span class="block">{line}</span>)
          : title
      }
    </h1>
    {subtitle && <p class="page-heading-description">{subtitle}</p>}
    {
      showCTA && (
        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a
            href={u('/services/')}
            class="ac-btn-primary"
            data-ga-event="cta_click"
            data-ga-label="hero_services"
            data-ga-location="hero"
            data-ga-destination={u('/services/')}
          >
            {t(locale, 'hero.ctaServices')}
            <Icon name="arrow-right" class="ml-3" />
          </a>
          <a href={u('/about/')} class="ac-text-link">
            {t(locale, 'pages.home.viewAbout')}
          </a>
        </div>
      )
    }
  </div>
</section>
