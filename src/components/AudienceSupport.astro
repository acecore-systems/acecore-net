---
import castRelease from '../data/cast-release.json'
import { SITE } from '../data/site'
import { t, type Locale } from '../i18n'
import { getSchoolsUrl } from '../utils/schools-url'
import { getSpecialistUrl } from '../utils/specialist-url'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const portrait = (subjectId: string) => {
  const asset = castRelease.assets.find((item) => item.subjectId === subjectId)
  if (!asset) throw new Error(`Missing approved cast portrait: ${subjectId}`)
  return asset
}
const cards = [
  {
    key: 'business',
    image: portrait('hatt'),
    href: getSpecialistUrl(SITE.social.systems, locale, '/services/'),
  },
  {
    key: 'learning',
    image: portrait('acvc-003'),
    href: getSchoolsUrl('/learning/'),
  },
  {
    key: 'digital',
    image: portrait('acvc-006'),
    href: getSchoolsUrl('/learning/#digital'),
  },
]
---

<section class="ac-section bg-white" aria-labelledby="audience-heading">
  <div class="ac-container">
    <div class="ac-section-intro">
      <h2 id="audience-heading" class="mb-4 text-2xl ac-heading sm:text-3xl">
        {t(locale, 'pages.services.audience.heading')}
      </h2>
      <p class="max-w-3xl ac-muted">
        {t(locale, 'pages.services.audience.lead')}
      </p>
    </div>
    <div class="audience-grid">
      {
        cards.map(({ key, image, href }) => (
          <article class="audience-card">
            <figure>
              <img
                src={image.url}
                alt={t(locale, `pages.services.audience.${key}.imageAlt`)}
                width={image.width}
                height={image.height}
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                {t(locale, 'pages.services.audience.aiLabel')}
              </figcaption>
            </figure>
            <div class="audience-copy">
              <h3>{t(locale, `pages.services.audience.${key}.title`)}</h3>
              <p>{t(locale, `pages.services.audience.${key}.body`)}</p>
              <a href={href}>
                {t(locale, `pages.services.audience.${key}.linkLabel`)}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
    <p class="audience-disclosure">
      {t(locale, 'pages.services.audience.disclaimer')}{' '}
      <a href="https://cast.acecore.net/">
        {t(locale, 'pages.services.audience.sourceLabel')}
      </a>
    </p>
  </div>
</section>

<style>
  .audience-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .audience-card {
    overflow: hidden;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    background: #f8fafc;
  }

  figure {
    margin: 0;
    padding: 1.5rem 1.5rem 0;
  }

  img {
    display: block;
    width: 100%;
    max-width: 9rem;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 0.625rem;
  }

  figcaption {
    margin-top: 0.5rem;
    color: #475569;
    font-size: 0.75rem;
  }

  .audience-copy {
    padding: 1.25rem 1.5rem 1.5rem;
  }

  h3 {
    color: #0f172a;
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.6;
  }

  .audience-copy p {
    margin: 0.75rem 0 1rem;
    color: #475569;
    font-size: 0.9375rem;
    line-height: 1.8;
  }

  .audience-copy a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #1d4ed8;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .audience-disclosure {
    margin-top: 1.5rem;
    color: #475569;
    font-size: 0.8125rem;
    line-height: 1.8;
  }

  .audience-disclosure a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 767px) {
    .audience-grid {
      grid-template-columns: 1fr;
    }

    .audience-card {
      display: grid;
      grid-template-columns: minmax(6rem, 30%) minmax(0, 1fr);
      align-items: start;
    }

    figure {
      padding: 1rem 0 1rem 1rem;
    }

    .audience-copy {
      padding: 1rem;
    }
  }
</style>
