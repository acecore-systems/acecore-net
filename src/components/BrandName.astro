---
import BrandWord from './BrandWord.astro'
interface Props {
  name: string
}
const { name } = Astro.props
const prefix = 'Acecore '
---

{name.startsWith(prefix) ? (
  <>
    <BrandWord word="Acecore" kind="corporate" />{' '}
    <BrandWord word={name.slice(prefix.length)} kind="service" />
  </>
) : (
  name
)}
