---
import Icon from './Icon.astro'
import { SITE } from '../data/site'
import { t, getLocaleFromUrl, getLocalizedUrl, type Locale } from '../i18n'

interface Props {
  locale?: Locale
  monetized?: boolean
}

const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url)
const monetized = Astro.props.monetized ?? false
---

<dialog
  id="search-dialog"
  class="fixed inset-0 z-100 m-0 h-full w-full max-h-full max-w-full bg-transparent backdrop:bg-black/50"
  aria-labelledby="search-dialog-title"
  data-locale={locale}
  data-t-search-title={t(locale, 'common.search')}
  data-t-close={t(locale, 'common.close')}
  data-t-loading={t(locale, 'blog.searchLoading')}
  data-t-error={t(locale, 'blog.searchError')}
  data-t-retry={t(locale, 'blog.searchRetry')}
  data-t-placeholder={t(locale, 'common.searchPlaceholder')}
  data-t-zero-results={t(locale, 'blog.zeroResults')}
  data-t-many-results={t(locale, 'blog.manyResults')}
  data-t-one-result={t(locale, 'blog.oneResult')}
  data-t-filters={t(locale, 'blog.filtersLabel')}
  data-t-fallback-heading={t(locale, 'blog.searchFallbackHeading')}
  data-t-fallback-blog={t(locale, 'blog.searchFallbackBlogList')}
  data-t-fallback-services={t(locale, 'blog.searchFallbackServiceList')}
  data-t-fallback-contact={t(locale, 'blog.searchFallbackContact')}
  data-t-semantic-heading={t(locale, 'blog.semanticHeading')}
  data-t-semantic-loading={t(locale, 'blog.semanticLoading')}
  data-t-semantic-zero-results={t(locale, 'blog.semanticZeroResults')}
  data-t-semantic-many-results={t(locale, 'blog.semanticManyResults')}
  data-t-semantic-one-result={t(locale, 'blog.semanticOneResult')}
  data-t-pagefind-heading={t(locale, 'blog.pagefindFallbackHeading')}
  data-t-pagefind-notice={t(locale, 'blog.pagefindFallbackNotice')}
  data-t-network-heading={t(locale, 'blog.networkHeading')}
  data-t-network-loading={t(locale, 'blog.networkLoading')}
  data-t-network-many-results={t(locale, 'blog.networkManyResults')}
  data-t-network-one-result={t(locale, 'blog.networkOneResult')}
  data-network-api="https://acecore.net/api/network-search"
  data-link-blog={getLocalizedUrl('/blog/', locale)}
  data-link-services={getLocalizedUrl('/services/', locale)}
  data-link-contact={getLocalizedUrl('/contact/', locale)}
>
  <div
    class="flex min-h-full items-start justify-center px-4 pb-8 pt-14 sm:pt-24"
  >
    <div class="w-full max-w-3xl overflow-hidden rounded-lg bg-white shadow-xl">
      <div
        class="flex items-center justify-between border-b border-slate-200 px-5 py-4"
      >
        <span
          id="search-dialog-title"
          class="flex items-center gap-2 text-sm font-700 text-slate-700"
        >
          <Icon name="search" class="text-sm" />
          {t(locale, 'common.search')}
        </span>
        <button
          id="search-close"
          class="ac-touch rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-600"
          aria-label={t(locale, 'common.close')}
        >
          <Icon name="x" class="text-lg" />
        </button>
      </div>
      <div id="search-container" class="px-5 pt-5 pb-3">
        <label class="sr-only" for="semantic-search-input">
          {t(locale, 'common.searchPlaceholder')}
        </label>
        <input
          id="semantic-search-input"
          class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-base text-slate-900 shadow-sm outline-none transition-colors placeholder:text-slate-400 focus:border-brand-400 focus:ring-2 focus:ring-brand-100"
          type="search"
          minlength="2"
          maxlength="160"
          autocomplete="off"
          enterkeyhint="search"
          placeholder={t(locale, 'common.searchPlaceholder')}
        />
      </div>
      <p
        id="semantic-search-privacy-notice"
        class="px-5 pb-4 text-xs leading-relaxed text-slate-500"
      >
        {t(locale, 'blog.semanticPrivacyNotice')}
        <a
          href={getLocalizedUrl('/privacy/', locale)}
          class="ml-1 underline underline-offset-2 hover:text-slate-700"
        >
          {t(locale, 'blog.semanticPrivacyLink')}
        </a>
      </p>
      <section
        id="semantic-search"
        class="hidden border-t border-slate-100 px-5 pt-4 pb-5"
        aria-labelledby="semantic-search-heading"
      >
        <div class="mb-3 flex items-center justify-between gap-4">
          <h2
            id="semantic-search-heading"
            class="text-sm font-700 text-slate-700"
          >
            {t(locale, 'blog.semanticHeading')}
          </h2>
          <p
            id="semantic-search-status"
            class="text-xs text-slate-500"
            aria-live="polite"
          >
          </p>
        </div>
        <ol
          id="semantic-search-results"
          class="m-0 max-h-72 list-none divide-y divide-slate-100 overflow-y-auto p-0"
        >
        </ol>
      </section>
      <section
        id="pagefind-search"
        class="hidden border-t border-slate-100 px-5 pt-4 pb-5"
        aria-labelledby="pagefind-search-heading"
      >
        <div class="mb-3 flex items-center justify-between gap-4">
          <h2
            id="pagefind-search-heading"
            class="text-sm font-700 text-slate-700"
          >
            {t(locale, 'blog.pagefindFallbackHeading')}
          </h2>
          <p
            id="pagefind-search-status"
            class="text-xs text-slate-500"
            aria-live="polite"
          >
          </p>
        </div>
        <p
          id="pagefind-search-notice"
          class="mb-3 text-xs leading-relaxed text-slate-500"
        >
        </p>
        <div id="pagefind-search-container"></div>
      </section>
      <section
        id="network-search"
        class="hidden border-t border-slate-100 px-5 pt-4 pb-5"
        aria-labelledby="network-search-heading"
      >
        <div class="mb-3 flex items-center justify-between gap-4">
          <h2
            id="network-search-heading"
            class="text-sm font-700 text-slate-700"
          >
            {t(locale, 'blog.networkHeading')}
          </h2>
          <p
            id="network-search-status"
            class="text-xs text-slate-500"
            aria-live="polite"
          >
          </p>
        </div>
        <ol
          id="network-search-results"
          class="m-0 max-h-64 list-none divide-y divide-slate-100 overflow-y-auto p-0"
        >
        </ol>
      </section>
      {
        monetized && (
          <div
            id="search-ad"
            class="mt-2 hidden border-t border-slate-100 px-5 pt-4 pb-5"
            data-ace-ad-container
            data-ace-ad-state="pending"
          >
            <ins
              class="adsbygoogle"
              data-ace-ad-slot
              style="display:block"
              data-ad-client={SITE.adsenseClientId}
              data-ad-slot={SITE.adSlotId}
              data-ad-format="auto"
              data-full-width-responsive="true"
            />
          </div>
        )
      }
    </div>
  </div>
</dialog>
