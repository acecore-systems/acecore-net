---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import CampaignNotice from '../components/CampaignNotice.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import BusinessDepartments from '../components/BusinessDepartments.astro'
import ServiceOfferings from '../components/ServiceOfferings.astro'
import ServiceCard from '../components/ServiceCard.astro'
import { optimizeImage } from '../utils/image'
import { SITE } from '../data/site'
import { t, getLocalizedUrl, type Locale } from '../i18n'
import { getSchoolsUrl } from '../utils/schools-url'
import { getSpecialistUrl } from '../utils/specialist-url'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const u = (path: string) => getLocalizedUrl(path, locale)
---

<BaseLayout
  title={t(locale, 'pages.services.title')}
  titleContext={t(locale, 'pages.services.seoTitleContext')}
  description={t(locale, 'pages.services.description')}
  locale={locale}
>
  <Hero
    title={t(locale, 'pages.services.heroTitle')}
    subtitle={t(locale, 'pages.services.heroSubtitle')}
    images={[
      {
        src: optimizeImage(
          'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=1400&h=600&fit=crop&q=80&fm=webp',
        ),
        alt: t(locale, 'pages.services.heroImgAlt'),
      },
    ]}
  />

  <CampaignNotice locale={locale} page="services" />

  <section class="ac-section bg-slate-50">
    <div class="ac-container">
      <Breadcrumb
        items={[{ label: t(locale, 'pages.services.title') }]}
        locale={locale}
      />

      <div class="ac-section-intro">
        <p class="ac-eyebrow">{t(locale, 'pages.services.eyebrow')}</p>
        <h2 class="mb-4 text-2xl ac-heading sm:text-3xl">
          {t(locale, 'pages.services.departmentsHeading')}
        </h2>
        <p class="max-w-3xl ac-muted">
          {t(locale, 'pages.services.introBody')}
        </p>
      </div>

      <BusinessDepartments locale={locale} overview />
      <div
        id="design-details"
        class="mt-8 rounded-lg border border-slate-200 bg-white p-6"
      >
        <h3 class="text-lg ac-heading">
          {t(locale, 'pages.services.designTitle')}
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">
          {t(locale, 'pages.services.designDescription')}
        </p>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">
          {t(locale, 'pages.services.designNote')}
        </p>
        <a href={u('/contact/')} class="ac-link mt-4 inline-flex"
          >{t(locale, 'pages.services.contactCta')}</a
        >
      </div>
    </div>
  </section>

  <section
    id="offerings"
    class="ac-section bg-white"
    aria-labelledby="offerings-heading"
  >
    <div class="ac-container">
      <div class="ac-section-intro">
        <h2 id="offerings-heading" class="mb-4 text-2xl ac-heading sm:text-3xl">
          {t(locale, 'pages.services.offeringsHeading')}
        </h2>
      </div>
      <ServiceOfferings locale={locale} />
    </div>
  </section>
  <section
    id="pricing"
    class="ac-section bg-slate-50"
    aria-labelledby="pricing-heading"
  >
    <div class="ac-container">
      <div class="ac-section-intro">
        <h2 id="pricing-heading" class="mb-4 text-2xl ac-heading sm:text-3xl">
          {t(locale, 'pages.services.pricingHeading')}
        </h2>
        <p class="max-w-3xl ac-muted">
          {t(locale, 'pages.services.pricingLead')}
        </p>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <ServiceCard
          title={t(locale, 'pages.pricing.systemsTitle')}
          description={t(locale, 'pages.services.developmentTitle') +
            ' / ' +
            t(locale, 'pages.services.advisorTitle')}
          icon="code-xml"
          href={getSpecialistUrl(SITE.social.systems, locale, '/pricing/')}
          locale={locale}
        />
        <ServiceCard
          title={t(locale, 'pages.pricing.schoolsTitle')}
          description={t(locale, 'pages.services.learningTitle')}
          icon="graduation-cap"
          tone="amber"
          href={getSchoolsUrl('/pricing/')}
          locale={locale}
        />
      </div>
    </div>
  </section>

  <section class="ac-section bg-white">
    <div class="ac-container max-w-3xl text-center">
      <h2 class="mb-4 text-2xl ac-heading sm:text-3xl">
        {t(locale, 'pages.services.contactHeading')}
      </h2>
      <p class="mx-auto mb-7 max-w-2xl ac-muted">
        {t(locale, 'pages.services.contactBody')}
      </p>
      <a href={u('/contact/')} class="ac-btn-primary">
        {t(locale, 'pages.services.contactCta')}
      </a>
    </div>
  </section>
</BaseLayout>
