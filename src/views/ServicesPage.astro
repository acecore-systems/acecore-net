---
import BaseLayout from '../layouts/BaseLayout.astro'
import CampaignNotice from '../components/CampaignNotice.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import PageSectionNav from '../components/PageSectionNav.astro'
import BusinessDepartments from '../components/BusinessDepartments.astro'
import ServiceOfferings from '../components/ServiceOfferings.astro'
import ContactBand from '../components/ContactBand.astro'
import BrandName from '../components/BrandName.astro'
import ArrowLink from '../components/ArrowLink.astro'
import { SITE } from '../data/site'
import { t, type Locale } from '../i18n'
import { getSchoolsUrl } from '../utils/schools-url'
import { getSpecialistUrl } from '../utils/specialist-url'
interface Props {
  locale: Locale
}
const { locale } = Astro.props
---

<BaseLayout
  title={t(locale, 'pages.services.title')}
  titleContext={t(locale, 'pages.services.seoTitleContext')}
  description={t(locale, 'pages.services.description')}
  locale={locale}
>
  <CampaignNotice locale={locale} page="services" />
  <div class="ac-container page-top">
    <Breadcrumb
      items={[{ label: t(locale, 'pages.services.title') }]}
      locale={locale}
    />
    <header class="page-intro">
      <h1 class="ac-page-title">{t(locale, 'pages.services.heroTitle')}</h1>
      <p>{t(locale, 'pages.services.heroSubtitle')}</p>
    </header>
    <PageSectionNav
      locale={locale}
      items={[
        { href: '#departments', label: t(locale, 'pages.services.introTitle') },
        {
          href: '#offerings',
          label: t(locale, 'pages.services.offeringsHeading'),
        },
        { href: '#pricing', label: t(locale, 'pages.services.pricingHeading') },
      ]}
    />
  </div>
  <section
    class="ac-section services-departments"
    aria-labelledby="departments"
  >
    <div class="ac-container ac-editorial">
      <div class="ac-section-lead">
        <h2 id="departments" class="ac-section-title">
          {t(locale, 'pages.services.introTitle')}
        </h2>
        <p class="mt-6 ac-muted">{t(locale, 'pages.services.introBody')}</p>
      </div>
      <div>
        <BusinessDepartments locale={locale} />
      </div>
    </div>
  </section>
  <section
    id="offerings"
    class="ac-section services-offerings-section"
    aria-labelledby="offerings-heading"
  >
    <div class="ac-container ac-editorial">
      <h2 id="offerings-heading" class="ac-section-title">
        {t(locale, 'pages.services.offeringsHeading')}
      </h2>
      <ServiceOfferings locale={locale} />
    </div>
  </section>
  <section
    id="pricing"
    class="ac-section services-pricing"
    aria-labelledby="pricing-heading"
  >
    <div class="ac-container ac-editorial">
      <div>
        <h2 id="pricing-heading" class="ac-section-title">
          {t(locale, 'pages.services.pricingHeading')}
        </h2>
        <p class="mt-6 ac-muted">{t(locale, 'pages.services.pricingLead')}</p>
      </div>
      <ul class="pricing-destinations">
        {[
          {
            department: 'systems',
            label: t(locale, 'pages.services.systemsTitle'),
            href: getSpecialistUrl(SITE.social.systems, locale, '/pricing/'),
          },
          {
            department: 'schools',
            label: t(locale, 'pages.services.schoolsTitle'),
            href: getSchoolsUrl('/pricing/'),
          },
          {
            department: 'designs',
            label: t(locale, 'pages.services.designTitle'),
            href: getSpecialistUrl(SITE.social.designs, locale, '/#catalog'),
          },
        ].map(({ department, label, href }) => (
          <li data-department={department}>
            <ArrowLink href={href} locale={locale} external>
              <span class="block text-xl font-800">
                <BrandName name={label} />
              </span>
              <span class="mt-2 block text-sm">
                {t(locale, 'pages.services.pricingCta')}
              </span>
            </ArrowLink>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <ContactBand
    locale={locale}
    title={t(locale, 'pages.services.contactHeading')}
    body={t(locale, 'pages.services.contactBody')}
    label={t(locale, 'pages.services.contactCta')}
  />
</BaseLayout>
