---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import CampaignNotice from '../components/CampaignNotice.astro'
import ServiceOfferings from '../components/ServiceOfferings.astro'
import Icon from '../components/Icon.astro'
import { SITE } from '../data/site'
import { t, getLocalizedUrl, type Locale } from '../i18n'
import { getSchoolsUrl } from '../utils/schools-url'
import { getSpecialistUrl } from '../utils/specialist-url'
interface Props {
  locale: Locale
}
const { locale } = Astro.props
const u = (path: string) => getLocalizedUrl(path, locale)
---

<BaseLayout
  title={t(locale, 'pages.services.title')}
  titleContext={t(locale, 'pages.services.seoTitleContext')}
  description={t(locale, 'pages.services.description')}
  locale={locale}
>
  <Hero
    title={t(locale, 'pages.services.heroTitle')}
    subtitle={t(locale, 'pages.services.heroSubtitle')}
    locale={locale}
  />
  <CampaignNotice locale={locale} page="services" />
  <div class="ac-container">
    <nav
      class="section-nav"
      aria-label={t(locale, 'pages.services.pageNavLabel')}
    >
      {
        ['systems', 'schools', 'design'].map((key) => (
          <a href={'#' + key}>{t(locale, `pages.services.${key}Title`)}</a>
        ))
      }
      <a href="#community">{t(locale, 'pages.services.communityHeading')}</a>
      <a href="#pricing">{t(locale, 'pages.services.pricingHeading')}</a>
    </nav>
    <div id="offerings">
      {
        (['systems', 'schools'] as const).map((key) => (
          <section id={key} class="ac-editorial business-section">
            <div>
              <h2 class="ac-section-title">
                {t(locale, `pages.services.${key}Title`)}
              </h2>
              <p class="mt-4 leading-relaxed text-slate-600">
                {t(locale, `pages.services.${key}Role`)}
              </p>
            </div>
            <ServiceOfferings locale={locale} group={key} />
          </section>
        ))
      }
      <section id="design" class="ac-editorial business-section">
        <div>
          <h2 class="ac-section-title">
            {t(locale, 'pages.services.designTitle')}
          </h2>
          <p class="mt-3 text-sm text-slate-500">
            {t(locale, 'pages.services.designStatus')}
          </p>
        </div>
        <div>
          <p class="text-lg font-700 text-slate-950">
            {t(locale, 'pages.services.designRole')}
          </p>
          <p class="mt-3 leading-relaxed text-slate-600">
            {t(locale, 'pages.services.designDescription')}
          </p>
          <p class="mt-3 leading-relaxed text-slate-600">
            {t(locale, 'pages.services.designNote')}
          </p>
          <a href={u('/contact/')} class="ac-text-link mt-5 inline-flex"
            >{t(locale, 'pages.services.contactCta')}</a
          >
        </div>
      </section>
      <section id="community" class="ac-editorial business-section">
        <h2 class="ac-section-title">
          {t(locale, 'pages.services.communityHeading')}
        </h2>
        <div>
          <ServiceOfferings locale={locale} group="community" />
          <aside class="service-row border-t border-slate-200">
            <div class="flex flex-wrap items-center gap-3">
              <h3 class="text-lg font-700 text-slate-950">
                <a class="ac-text-link" href={u('/acestudio/')}>AceStudio</a>
              </h3>
              <span class="text-xs text-slate-500"
                >{t(locale, 'pages.services.acestudioStatus')}</span
              >
            </div>
            <p class="mt-3 leading-relaxed text-slate-600">
              {t(locale, 'pages.services.acestudioDescription')}
            </p>
          </aside>
        </div>
      </section>
    </div>
    <section id="pricing" class="ac-editorial business-section">
      <h2 class="ac-section-title">
        {t(locale, 'pages.services.pricingHeading')}
      </h2>
      <div>
        <p class="mb-5 leading-relaxed text-slate-600">
          {t(locale, 'pages.services.pricingLead')}
        </p>
        <ul class="divide-y divide-slate-200">
          {
            [
              {
                title: t(locale, 'pages.pricing.systemsTitle'),
                href: getSpecialistUrl(
                  SITE.social.systems,
                  locale,
                  '/pricing/',
                ),
              },
              {
                title: t(locale, 'pages.pricing.schoolsTitle'),
                href: getSchoolsUrl('/pricing/'),
              },
            ].map((item) => (
              <li>
                <a
                  href={item.href}
                  class="department-link py-4 text-brand-600"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <>
                    <span>{item.title}</span>
                    <Icon name="arrow-up-right" />
                    <span class="sr-only">
                      {t(locale, 'common.opensInNewTab')}
                    </span>
                  </>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
    <div class="contact-line">
      <p>{t(locale, 'pages.services.contactBody')}</p>
      <a href={u('/contact/')} class="ac-btn-primary"
        >{t(locale, 'pages.services.contactCta')}</a
      >
    </div>
  </div>
</BaseLayout>
