---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import CampaignNotice from '../components/CampaignNotice.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import ServiceCard from '../components/ServiceCard.astro'
import { optimizeImage } from '../utils/image'
import { SITE } from '../data/site'
import { t, getLocalizedUrl, type Locale } from '../i18n'
import { getSchoolsUrl } from '../utils/schools-url'
import { getSpecialistUrl } from '../utils/specialist-url'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const u = (path: string) => getLocalizedUrl(path, locale)
const businesses = [
  {
    title: t(locale, 'pages.services.systemsTitle'),
    description: t(locale, 'pages.services.systemsDescription'),
    href: getSpecialistUrl(SITE.social.systems, locale, '/services/'),
    icon: 'code-xml',
    tone: 'brand' as const,
  },
  {
    title: t(locale, 'pages.services.schoolsTitle'),
    description: t(locale, 'pages.services.schoolsDescription'),
    href: getSchoolsUrl(),
    icon: 'graduation-cap',
    tone: 'amber' as const,
  },
  {
    title: t(locale, 'pages.services.aceserverTitle'),
    description: t(locale, 'pages.services.aceserverDescription'),
    href: getSpecialistUrl(SITE.social.aceserver, locale),
    icon: 'gamepad-2',
    tone: 'emerald' as const,
  },
  {
    title: t(locale, 'pages.services.storeTitle'),
    description: t(locale, 'pages.services.storeDescription'),
    href: SITE.social.store,
    icon: 'shopping-bag',
    tone: 'slate' as const,
  },
]
---

<BaseLayout
  title={t(locale, 'pages.services.title')}
  titleContext={t(locale, 'pages.services.seoTitleContext')}
  description={t(locale, 'pages.services.description')}
  locale={locale}
>
  <Hero
    title={t(locale, 'pages.services.heroTitle')}
    subtitle={t(locale, 'pages.services.heroSubtitle')}
    images={[
      {
        src: optimizeImage(
          'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=1400&h=600&fit=crop&q=80&fm=webp',
        ),
        alt: t(locale, 'pages.services.heroImgAlt'),
      },
    ]}
  />

  <CampaignNotice locale={locale} page="services" />

  <section class="ac-section bg-slate-50">
    <div class="ac-container">
      <Breadcrumb
        items={[{ label: t(locale, 'pages.services.title') }]}
        locale={locale}
      />

      <div class="ac-section-intro">
        <p class="ac-eyebrow">{t(locale, 'pages.services.eyebrow')}</p>
        <h2 class="mb-4 text-2xl ac-heading sm:text-3xl">
          {t(locale, 'pages.services.introTitle')}
        </h2>
        <p class="max-w-3xl ac-muted">
          {t(locale, 'pages.services.introBody')}
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">
        {
          businesses.map((business) => (
            <ServiceCard
              icon={business.icon}
              title={business.title}
              description={business.description}
              href={business.href}
              locale={locale}
              tone={business.tone}
            />
          ))
        }
      </div>

      <div
        class="mt-8 rounded-lg border border-slate-200 bg-white p-6 sm:flex sm:items-center sm:justify-between sm:gap-6"
      >
        <div>
          <div class="flex flex-wrap items-center gap-3">
            <h2 class="text-lg ac-heading">
              {t(locale, 'pages.services.acestudioTitle')}
            </h2>
            <span class="ac-chip text-xs">
              {t(locale, 'pages.services.acestudioStatus')}
            </span>
          </div>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-600">
            {t(locale, 'pages.services.acestudioDescription')}
          </p>
        </div>
        <a
          href={u('/acestudio/')}
          class="ac-link mt-4 inline-flex shrink-0 sm:mt-0"
        >
          {t(locale, 'pages.services.acestudioTitle')}
        </a>
      </div>
    </div>
  </section>

  <section class="ac-section bg-white">
    <div class="ac-container max-w-3xl text-center">
      <h2 class="mb-4 text-2xl ac-heading sm:text-3xl">
        {t(locale, 'pages.services.contactHeading')}
      </h2>
      <p class="mx-auto mb-7 max-w-2xl ac-muted">
        {t(locale, 'pages.services.contactBody')}
      </p>
      <a href={u('/contact/')} class="ac-btn-primary">
        {t(locale, 'pages.services.contactCta')}
      </a>
    </div>
  </section>
</BaseLayout>
