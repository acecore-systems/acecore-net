---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import CampaignNotice from '../components/CampaignNotice.astro'
import ServiceOfferings from '../components/ServiceOfferings.astro'
import BusinessDepartments from '../components/BusinessDepartments.astro'
import Icon from '../components/Icon.astro'
import { SITE } from '../data/site'
import { t, getLocalizedUrl, type Locale } from '../i18n'
import { getSchoolsUrl } from '../utils/schools-url'
import { getSpecialistUrl } from '../utils/specialist-url'
interface Props {
  locale: Locale
}
const { locale } = Astro.props
const u = (path: string) => getLocalizedUrl(path, locale)
---

<BaseLayout
  title={t(locale, 'pages.services.title')}
  titleContext={t(locale, 'pages.services.seoTitleContext')}
  description={t(locale, 'pages.services.description')}
  locale={locale}
>
  <Hero
    title={t(locale, 'pages.services.heroTitle')}
    subtitle={t(locale, 'pages.services.heroSubtitle')}
    locale={locale}
  />
  <CampaignNotice locale={locale} page="services" />
  <div class="ac-container">
    <section aria-labelledby="departments-heading" class="pb-10">
      <div class="home-section-heading">
        <h2 id="departments-heading" class="ac-section-title">
          {t(locale, 'pages.services.departmentsHeading')}
        </h2>
        <a href="#pricing" class="ac-text-link"
          >{t(locale, 'pages.services.pricingHeading')}</a
        >
      </div>
      <BusinessDepartments locale={locale} overview />
    </section>
    <section
      id="offerings"
      class="business-section"
      aria-labelledby="offerings-heading"
    >
      <h2 id="offerings-heading" class="ac-section-title mb-6">
        {t(locale, 'pages.services.offeringsHeading')}
      </h2>
      <ServiceOfferings locale={locale} />
    </section>
    <section id="design-details" class="ac-editorial business-section">
      <h2 class="ac-section-title">
        {t(locale, 'pages.services.designTitle')}
      </h2>
      <div>
        <p class="leading-relaxed text-slate-600">
          {t(locale, 'pages.services.designDescription')}
        </p>
        <p class="mt-3 leading-relaxed text-slate-600">
          {t(locale, 'pages.services.designNote')}
        </p>
        <a href={u('/contact/')} class="ac-text-link mt-5 inline-flex"
          >{t(locale, 'pages.services.contactCta')}</a
        >
      </div>
    </section>
    <section id="pricing" class="ac-editorial business-section">
      <h2 class="ac-section-title">
        {t(locale, 'pages.services.pricingHeading')}
      </h2>
      <div>
        <p class="mb-5 leading-relaxed text-slate-600">
          {t(locale, 'pages.services.pricingLead')}
        </p>
        <ul class="divide-y divide-slate-200">
          {
            [
              {
                title: t(locale, 'pages.pricing.systemsTitle'),
                href: getSpecialistUrl(
                  SITE.social.systems,
                  locale,
                  '/pricing/',
                ),
              },
              {
                title: t(locale, 'pages.pricing.schoolsTitle'),
                href: getSchoolsUrl('/pricing/'),
              },
            ].map((item) => (
              <li>
                <a
                  href={item.href}
                  class="flex items-center justify-between gap-4 py-4 text-brand-600 hover:underline"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <>
                    <span>{item.title}</span>
                    <Icon name="arrow-up-right" />
                    <span class="sr-only">
                      {t(locale, 'common.opensInNewTab')}
                    </span>
                  </>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
    <div class="contact-line">
      <p>{t(locale, 'pages.services.contactBody')}</p>
      <a href={u('/contact/')} class="ac-btn-primary"
        >{t(locale, 'pages.services.contactCta')}</a
      >
    </div>
  </div>
</BaseLayout>
