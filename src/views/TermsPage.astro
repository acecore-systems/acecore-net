---
import '../styles/prose.css'
import BaseLayout from '../layouts/BaseLayout.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import LegalContents from '../components/LegalContents.astro'
import {
  getAlternateUrls,
  getLocalizedUrl,
  getTranslationValue,
  t,
  type Locale,
} from '../i18n'

interface Props {
  locale: Locale
}

type LegalSection = {
  heading: string
  paragraphs: string[]
  items?: string[]
}

const { locale } = Astro.props
const contentLocale: Locale = locale === 'ja' ? 'ja' : 'en'
const u = (path: string) => getLocalizedUrl(path, locale)
const termsAlternateUrls = getAlternateUrls(
  '/terms/',
  Astro.site?.origin || 'https://acecore.net',
).filter(
  ({ locale: alternateLocale }) =>
    alternateLocale === 'ja' || alternateLocale === 'en',
)
const sections =
  getTranslationValue<LegalSection[]>(contentLocale, 'pages.terms.sections') ??
  []
---

<BaseLayout
  title={t(contentLocale, 'pages.terms.title')}
  titleContext={t(contentLocale, 'pages.terms.seoTitleContext')}
  description={t(contentLocale, 'pages.terms.description')}
  locale={locale}
  canonicalPath={getLocalizedUrl('/terms/', contentLocale)}
  alternateUrls={termsAlternateUrls}
>
  <section class="ac-section legal-page">
    <div class="ac-container max-w-3xl">
      <Breadcrumb
        items={[{ label: t(contentLocale, 'pages.terms.title') }]}
        locale={locale}
      />
      <h1 class="ac-page-title legal-title">
        {t(contentLocale, 'pages.terms.heroTitle')}
      </h1>
      <div class="legal-reading-layout">
        <LegalContents
          locale={locale}
          items={[
            ...sections.map((section, index) => ({
              id: `terms-${index + 1}`,
              label: section.heading,
              lang: contentLocale,
            })),
            {
              id: 'privacy-policy',
              label: t(contentLocale, 'pages.terms.privacyLinkHeading'),
              lang: contentLocale,
            },
          ]}
        />
        <div class="ac-prose max-w-none" lang={contentLocale}>
          <p>{t(contentLocale, 'pages.terms.lead')}</p>

          {sections.map((section, index) => (
            <section>
              <h2 id={`terms-${index + 1}`}>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              {section.items && section.items.length > 0 ? (
                <ul>
                  {section.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              ) : null}
            </section>
          ))}

          <h2 id="privacy-policy">
            {t(contentLocale, 'pages.terms.privacyLinkHeading')}
          </h2>
          <p>{t(contentLocale, 'pages.terms.privacyLinkBody')}</p>
          <p>
            <a href={u('/privacy/')}>
              {t(contentLocale, 'pages.terms.privacyLinkLabel')}
            </a>
          </p>

          <p class="text-sm text-slate-500 mt-12">
            {t(contentLocale, 'pages.terms.effectiveDate')}
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
