---
import BaseLayout from '../layouts/BaseLayout.astro'
import CampaignNotice from '../components/CampaignNotice.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import Icon from '../components/Icon.astro'
import { SITE } from '../data/site'
import { t, getLocalizedUrl, type Locale } from '../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const u = (path: string) => getLocalizedUrl(path, locale)
---

<BaseLayout
  title={t(locale, 'pages.acestudio.title')}
  titleContext={t(locale, 'pages.acestudio.seoTitleContext')}
  description={t(locale, 'pages.acestudio.description')}
  locale={locale}
>
  <CampaignNotice locale={locale} page="acestudio" />

  <section class="ac-section">
    <div class="ac-container max-w-3xl text-center">
      <div class="text-left">
        <Breadcrumb items={[{ label: 'AceStudio' }]} locale={locale} />
      </div>

      <div class="ac-surface bg-white p-6 sm:p-10">
        <h1 class="mb-5 text-3xl ac-heading sm:text-4xl">
          {t(locale, 'pages.acestudio.heroTitle')}
        </h1>
        <p class="text-sm font-700 uppercase tracking-widest text-brand-700 mb-4">
          {t(locale, 'pages.acestudio.statusEyebrow')}
        </p>
        <Icon
          name="clapperboard"
          class="text-5xl text-brand-500 mx-auto mb-6"
        />
        <p class="mb-6 text-lg font-700 text-brand-700">
          {t(locale, 'pages.services.acestudioStatus')}
        </p>
        <p class="text-lg text-slate-600 leading-relaxed mb-4">
          {t(locale, 'pages.acestudio.statusBody')}
        </p>
        <p class="text-slate-500 leading-relaxed">
          {t(locale, 'pages.acestudio.statusNote')}
        </p>
        <div class="mt-8 border-t border-slate-200 pt-6">
          <h2 class="mb-3 text-lg ac-heading">
            {t(locale, 'pages.acestudio.newsHeading')}
          </h2>
          <p class="mb-5 text-sm leading-relaxed text-slate-600">
            {t(locale, 'pages.acestudio.newsBody')}
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href={SITE.social.x}
              target="_blank"
              rel="noopener noreferrer"
              class="ac-btn-outline"
            >
              {t(locale, 'pages.acestudio.followX')}
              <span class="sr-only">{t(locale, 'common.opensInNewTab')}</span>
            </a>
            <a href={u('/blog/')} class="ac-btn-outline">
              {t(locale, 'pages.acestudio.viewNews')}
            </a>
          </div>
        </div>
      </div>

      <div class="mt-8 text-center">
        <p class="text-slate-600 mb-4">
          {t(locale, 'pages.acestudio.inquiryText')}
        </p>
        <a
          href={
            u('/contact/') + '?category=service&service=acestudio#contact-form'
          }
          class="ac-btn-primary"
        >
          {t(locale, 'pages.acestudio.inquiryButton')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
