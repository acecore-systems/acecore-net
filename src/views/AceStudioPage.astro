---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import CampaignNotice from '../components/CampaignNotice.astro'
import { t, getLocalizedUrl, type Locale } from '../i18n'
interface Props {
  locale: Locale
}
const { locale } = Astro.props
const u = (path: string) => getLocalizedUrl(path, locale)
---

<BaseLayout
  title={t(locale, 'pages.acestudio.title')}
  titleContext={t(locale, 'pages.acestudio.seoTitleContext')}
  description={t(locale, 'pages.acestudio.description')}
  locale={locale}
>
  <Hero title={t(locale, 'pages.acestudio.heroTitle')} locale={locale} />
  <CampaignNotice locale={locale} page="acestudio" />
  <section class="ac-container pb-16 sm:pb-24">
    <div class="max-w-3xl">
      <h2 class="ac-section-title">
        {t(locale, 'pages.acestudio.statusHeading')}
      </h2>
      <p class="mt-6 text-lg leading-loose text-slate-600">
        {t(locale, 'pages.acestudio.statusBody')}
      </p>
      <p class="mt-4 leading-loose text-slate-600">
        {t(locale, 'pages.acestudio.statusNote')}
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-6">
        <a href={u('/contact/')} class="ac-btn-primary"
          >{t(locale, 'pages.acestudio.inquiryButton')}</a
        >
        <a href={u('/blog/')} class="ac-text-link"
          >{t(locale, 'pages.acestudio.viewNews')}</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
