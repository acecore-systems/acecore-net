---
import BaseLayout from '../layouts/BaseLayout.astro'
import CampaignNotice from '../components/CampaignNotice.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import Icon from '../components/Icon.astro'
import { SITE } from '../data/site'
import { t, getLocalizedUrl, type Locale } from '../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const u = (path: string) => getLocalizedUrl(path, locale)
---

<BaseLayout
  title={t(locale, 'pages.acestudio.title')}
  titleContext={t(locale, 'pages.acestudio.seoTitleContext')}
  description={t(locale, 'pages.acestudio.description')}
  locale={locale}
>
  <CampaignNotice locale={locale} page="acestudio" />
  <section class="ac-section studio-page">
    <div class="ac-container">
      <Breadcrumb items={[{ label: 'AceStudio' }]} locale={locale} />
      <div class="studio-intro">
        <div>
          <h1 class="ac-page-title">
            {t(locale, 'pages.acestudio.heroTitle')}
          </h1>
          <p class="studio-description">
            {t(locale, 'pages.acestudio.statusBody')}
          </p>
          <p class="mt-5 ac-muted">{t(locale, 'pages.acestudio.statusNote')}</p>
        </div>
        <p class="studio-status">
          {t(locale, 'pages.services.acestudioStatus')}
        </p>
      </div>
      <section class="studio-updates ac-editorial">
        <h2 class="ac-section-title">
          {t(locale, 'pages.acestudio.newsHeading')}
        </h2>
        <div>
          <p class="ac-muted">{t(locale, 'pages.acestudio.newsBody')}</p>
          <div class="mt-7 flex flex-wrap gap-5">
            <a
              href={SITE.social.x}
              target="_blank"
              rel="noopener noreferrer"
              class="ac-btn-outline"
            >
              {t(locale, 'pages.acestudio.followX')}
              <Icon name="arrow-up-right" />
              <span class="sr-only">{t(locale, 'common.opensInNewTab')}</span>
            </a>
            <a href={u('/blog/')} class="ac-btn-outline">
              {t(locale, 'pages.acestudio.viewNews')}
              <Icon name="arrow-right" />
            </a>
          </div>
        </div>
      </section>
      <div class="studio-inquiry">
        <p>{t(locale, 'pages.acestudio.inquiryText')}</p>
        <a
          href={
            u('/contact/') + '?category=service&service=acestudio#contact-form'
          }
          class="ac-btn-outline"
        >
          {t(locale, 'pages.acestudio.inquiryButton')}
          <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
