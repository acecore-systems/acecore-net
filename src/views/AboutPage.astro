---
import BaseLayout from '../layouts/BaseLayout.astro'
import { castScene, castSceneAsset } from '../data/cast-scenes'
import ArrowLink from '../components/ArrowLink.astro'
import CampaignNotice from '../components/CampaignNotice.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import PageSectionNav from '../components/PageSectionNav.astro'
import { SITE } from '../data/site'
import { t, getTranslationValue, getLocalizedUrl, type Locale } from '../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const u = (path: string) => getLocalizedUrl(path, locale)
const organizationId = `${SITE.url}/#organization`
interface Officer {
  name: string
  image?: string
  role?: string
  areas?: string[]
  bio?: string
}

const getList = <T,>(key: string): T[] =>
  getTranslationValue<T[]>(locale, key) ?? []

const officers = getList<Officer>('pages.about.officers')
const businessPurposes = getList<string>('pages.about.businessPurposes')
const philosophyParagraphs = getList<string>('pages.about.philosophyParagraphs')
const visionParagraphs = getList<string>('pages.about.visionParagraphs')

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': organizationId,
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.url,
  logo: 'https://acecore.net/favicon.svg',
  description: t(locale, 'meta.defaultDescription'),
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'JP',
  },
  sameAs: [SITE.social.x, SITE.social.github],
  knowsAbout: [
    'Acecore Systems',
    'Acecore Schools',
    'Aceserver',
    'Acecore Store',
    'テクノロジー',
    '教育',
    'コミュニティ',
    'プロダクト',
  ],
}

const aboutPageLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: t(locale, 'pages.about.title'),
  description: t(locale, 'pages.about.description'),
  url: `${SITE.url}${u('/about/')}`,
  about: { '@id': organizationId },
}
---

<BaseLayout
  title={t(locale, 'pages.about.title')}
  titleContext={t(locale, 'pages.about.seoTitleContext')}
  description={t(locale, 'pages.about.description')}
  jsonLd={[organizationLd, aboutPageLd]}
  locale={locale}
>
  <CampaignNotice locale={locale} page="about" />
  <div class="ac-container page-top">
    <Breadcrumb
      items={[{ label: t(locale, 'pages.about.title') }]}
      locale={locale}
    />
    <header class="page-intro">
      <h1 class="ac-page-title">{t(locale, 'pages.about.heroTitle')}</h1>
      <p>{t(locale, 'pages.about.heroSubtitle')}</p>
    </header>
    <PageSectionNav
      locale={locale}
      items={[
        {
          href: '#corporate-philosophy-heading',
          label: t(locale, 'pages.about.philosophyHeading'),
        },
        {
          href: '#corporate-vision-heading',
          label: t(locale, 'pages.about.visionHeading'),
        },
        {
          href: '#corporate-information-heading',
          label: t(locale, 'pages.about.companyInfoHeading'),
        },
        {
          href: '#executive-profile-heading',
          label: t(locale, 'pages.about.executiveHeading'),
        },
      ]}
    />
  </div>
  <div class="ac-container about-cast-scene">
    <img
      src={castScene('about-hero')}
      alt={t(locale, 'pages.about.heroImgAlt')}
      width={castSceneAsset('about-hero').width}
      height={castSceneAsset('about-hero').height}
      decoding="async"
      fetchpriority="high"
    />
  </div>
  <section
    class="about-philosophy"
    aria-labelledby="corporate-philosophy-heading"
  >
    <div class="ac-container ac-editorial ac-section">
      <h2 id="corporate-philosophy-heading" class="ac-section-title">
        {t(locale, 'pages.about.philosophyHeading')}
      </h2>
      <div>
        <p class="philosophy-motto">
          {t(locale, 'pages.about.philosophyMotto')}
        </p>
        <div class="philosophy-body">
          {philosophyParagraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>
    </div>
    <div class="about-vision">
      <div class="ac-container vision-layout">
        <div>
          <h3 id="corporate-vision-heading" class="ac-section-title">
            {t(locale, 'pages.about.visionHeading')}
          </h3>
          <p class="vision-motto">{t(locale, 'pages.about.visionMotto')}</p>
          <div class="vision-body">
            {visionParagraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>
        <figure class="philosophy-illustrations">
          <img
            src={castScene('about-workshop')}
            alt={t(locale, 'pages.about.workshopImgAlt')}
            width={castSceneAsset('about-workshop').width}
            height={castSceneAsset('about-workshop').height}
            loading="lazy"
            decoding="async"
          />
          <figcaption>{t(locale, 'pages.about.workshopCaption')}</figcaption>
        </figure>
      </div>
    </div>
  </section>
  <section class="ac-section" aria-labelledby="corporate-information-heading">
    <div class="ac-container ac-editorial">
      <h2 id="corporate-information-heading" class="ac-section-title">
        {t(locale, 'pages.about.companyInfoHeading')}
      </h2>
      <dl class="corporate-facts">
        <div>
          <dt>{t(locale, 'pages.about.legalNameLabel')}</dt>
          <dd>{SITE.legalName}</dd>
        </div>
        <div>
          <dt>{t(locale, 'pages.about.establishedLabel')}</dt>
          <dd>{t(locale, 'pages.about.establishedDate')}</dd>
        </div>
        <div>
          <dt>{t(locale, 'pages.about.businessPurposesLabel')}</dt>
          <dd>
            <ol>
              {businessPurposes.map((purpose, index) => (
                <li>
                  <span>({index + 1})</span>
                  <span>{purpose}</span>
                </li>
              ))}
            </ol>
          </dd>
        </div>
      </dl>
    </div>
  </section>
  {officers.length > 0 && (
    <section
      class="ac-section about-officers"
      aria-labelledby="executive-profile-heading"
    >
      <div class="ac-container ac-editorial">
        <div>
          <h2 id="executive-profile-heading" class="ac-section-title">
            {t(locale, 'pages.about.executiveHeading')}
          </h2>
          <p class="mt-5 ac-muted">{t(locale, 'pages.about.executiveLead')}</p>
        </div>
        <ul class="officer-list">
          {officers.map((officer) => (
            <li>
              <article class="officer-profile">
                <div class="officer-identity">
                  {officer.image && (
                    <img
                      src={officer.image}
                      alt={officer.name}
                      width="3096"
                      height="4128"
                      loading="lazy"
                      decoding="async"
                      style="object-position:center 10%;"
                    />
                  )}
                  <h3>{officer.name}</h3>
                  {officer.role && <p>{officer.role}</p>}
                </div>
                {(officer.areas?.length || officer.bio) && (
                  <dl>
                    {officer.areas?.length && (
                      <div>
                        <dt>{t(locale, 'pages.about.officerAreasLabel')}</dt>
                        <dd>{officer.areas.join('・')}</dd>
                      </div>
                    )}
                    {officer.bio && (
                      <div>
                        <dt>
                          {t(locale, 'pages.about.officerBiographyLabel')}
                        </dt>
                        <dd class="whitespace-pre-line">{officer.bio}</dd>
                      </div>
                    )}
                  </dl>
                )}
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
  <div class="ac-container pb-20">
    <ArrowLink href={u('/contact/')} locale={locale}>
      {t(locale, 'pages.about.corporateContactCta')}
    </ArrowLink>
  </div>
</BaseLayout>
