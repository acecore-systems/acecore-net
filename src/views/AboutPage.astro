---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import CampaignNotice from '../components/CampaignNotice.astro'
import { SITE } from '../data/site'
import { t, getTranslationValue, getLocalizedUrl, type Locale } from '../i18n'
interface Props {
  locale: Locale
}
interface Officer {
  name: string
  role?: string
  areas?: string[]
  bio?: string
}
interface Principle {
  title: string
  description: string
}
const { locale } = Astro.props
const u = (path: string) => getLocalizedUrl(path, locale)
const officers =
  getTranslationValue<Officer[]>(locale, 'pages.about.officers') ?? []
const principles =
  getTranslationValue<Principle[]>(locale, 'pages.about.valueCycle') ?? []
const organizationId = SITE.url + '/#organization'
const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': organizationId,
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.url,
  logo: SITE.url + '/favicon.svg',
  description: t(locale, 'meta.defaultDescription'),
  address: { '@type': 'PostalAddress', addressCountry: 'JP' },
  sameAs: [SITE.social.x, SITE.social.github],
}
const aboutPageLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: t(locale, 'pages.about.title'),
  description: t(locale, 'pages.about.description'),
  url: SITE.url + u('/about/'),
  about: { '@id': organizationId },
}
---

<BaseLayout
  title={t(locale, 'pages.about.title')}
  titleContext={t(locale, 'pages.about.seoTitleContext')}
  description={t(locale, 'pages.about.description')}
  jsonLd={[organizationLd, aboutPageLd]}
  locale={locale}
>
  <Hero title={t(locale, 'pages.about.heroTitle')} locale={locale} />
  <CampaignNotice locale={locale} page="about" />
  <div class="ac-container">
    <section
      class="ac-editorial business-section border-t-0 pt-0"
      aria-labelledby="philosophy-heading"
    >
      <h2 id="philosophy-heading" class="ac-section-title">
        {t(locale, 'pages.about.philosophyHeading')}
      </h2>
      <div>
        <p
          class="mb-6 text-2xl font-700 leading-relaxed text-slate-950 sm:text-3xl"
        >
          {t(locale, 'pages.about.philosophyMotto')}
        </p>
        <p class="leading-loose text-slate-600">
          {t(locale, 'pages.about.philosophyBody1')}
        </p>
        <p class="mt-4 leading-loose text-slate-600">
          {t(locale, 'pages.about.philosophyBody2')}
        </p>
        <ul class="mt-8 divide-y divide-slate-200">
          {
            principles.map((item) => (
              <li class="py-4">
                <h3 class="font-700 text-slate-900">{item.title}</h3>
                <p class="mt-2 leading-relaxed text-slate-600">
                  {item.description}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
    <section
      class="ac-editorial business-section"
      aria-labelledby="corporate-information-heading"
    >
      <h2 id="corporate-information-heading" class="ac-section-title">
        {t(locale, 'pages.about.companyInfoHeading')}
      </h2>
      <dl>
        <div class="flex flex-col gap-2 sm:flex-row sm:gap-10">
          <dt class="text-sm text-slate-500">
            {t(locale, 'pages.about.legalNameLabel')}
          </dt>
          <dd class="font-700 text-slate-900">{SITE.legalName}</dd>
        </div>
      </dl>
    </section>
    {
      officers.length > 0 && (
        <section
          class="ac-editorial business-section"
          aria-labelledby="executive-profile-heading"
        >
          <h2 id="executive-profile-heading" class="ac-section-title">
            {t(locale, 'pages.about.executiveHeading')}
          </h2>
          <ul class="divide-y divide-slate-200">
            {officers.map((officer) => (
              <li class="officer-row">
                <article>
                  <header>
                    <h3 class="text-xl font-700 text-slate-950">
                      {officer.name}
                    </h3>
                    {officer.role && (
                      <p class="mt-2 text-sm text-slate-600">{officer.role}</p>
                    )}
                  </header>
                  <div>
                    {officer.areas?.length && (
                      <p class="text-sm leading-relaxed text-slate-500">
                        <span class="sr-only">
                          {t(locale, 'pages.about.officerAreasLabel')}:
                        </span>
                        {officer.areas.join('・')}
                      </p>
                    )}
                    {officer.bio && (
                      <p class="mt-3 whitespace-pre-line leading-loose text-slate-600">
                        <span class="sr-only">
                          {t(locale, 'pages.about.officerBiographyLabel')}:
                        </span>
                        {officer.bio}
                      </p>
                    )}
                  </div>
                </article>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <div class="contact-line">
      <p>{t(locale, 'pages.about.ctaBody')}</p>
      <a href={u('/contact/')} class="ac-btn-primary"
        >{t(locale, 'pages.about.ctaContact')}</a
      >
    </div>
  </div>
</BaseLayout>
