---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import CampaignNotice from '../components/CampaignNotice.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import { optimizeImage, generateSrcSet } from '../utils/image'
import { SITE } from '../data/site'
import { t, getTranslationValue, getLocalizedUrl, type Locale } from '../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const u = (path: string) => getLocalizedUrl(path, locale)
const organizationId = `${SITE.url}/#organization`
const contentImageWidths = [480, 800, 1200, 1600]
const contentImageOptions = { aspectRatio: 16 / 9, quality: 80 }
const contentImageSizes = '(min-width: 1024px) 56rem, calc(100vw - 3rem)'

interface Officer {
  name: string
  role?: string
  areas?: string[]
  bio?: string
}

const getList = <T,>(key: string): T[] =>
  getTranslationValue<T[]>(locale, key) ?? []

const officers = getList<Officer>('pages.about.officers')
const businessPurposes = getList<string>('pages.about.businessPurposes')

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': organizationId,
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.url,
  logo: 'https://acecore.net/favicon.svg',
  description: t(locale, 'meta.defaultDescription'),
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'JP',
  },
  sameAs: [SITE.social.x, SITE.social.github],
  knowsAbout: [
    'Acecore Systems',
    'Acecore Schools',
    'Aceserver',
    'Acecore Store',
    'テクノロジー',
    '教育',
    'コミュニティ',
    'プロダクト',
  ],
}

const aboutPageLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: t(locale, 'pages.about.title'),
  description: t(locale, 'pages.about.description'),
  url: `${SITE.url}${u('/about/')}`,
  about: { '@id': organizationId },
}
---

<BaseLayout
  title={t(locale, 'pages.about.title')}
  titleContext={t(locale, 'pages.about.seoTitleContext')}
  description={t(locale, 'pages.about.description')}
  jsonLd={[organizationLd, aboutPageLd]}
  locale={locale}
>
  <Hero
    title={t(locale, 'pages.about.heroTitle')}
    subtitle={t(locale, 'pages.about.heroSubtitle')}
    images={[
      {
        src: optimizeImage(
          'https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=1400&h=600&fit=crop&q=80&fm=webp',
        ),
        alt: t(locale, 'pages.about.heroImgAlt'),
      },
    ]}
    locale={locale}
  />

  <CampaignNotice locale={locale} page="about" />

  <section class="ac-section">
    <div class="ac-container max-w-4xl">
      <Breadcrumb
        items={[{ label: t(locale, 'pages.about.title') }]}
        locale={locale}
      />
      <section
        class="ac-surface mb-12 p-6 sm:p-8"
        aria-labelledby="corporate-information-heading"
      >
        <h2 id="corporate-information-heading" class="text-2xl ac-heading">
          {t(locale, 'pages.about.companyInfoHeading')}
        </h2>
        <dl class="mt-5 space-y-6">
          <div class="border-l-4 border-brand-500 pl-4">
            <dt class="text-sm font-600 text-slate-500">
              {t(locale, 'pages.about.legalNameLabel')}
            </dt>
            <dd class="mt-1 text-xl font-700 text-slate-800">
              {SITE.legalName}
            </dd>
          </div>
          <div class="border-l-4 border-brand-500 pl-4">
            <dt class="text-sm font-600 text-slate-500">
              {t(locale, 'pages.about.establishedLabel')}
            </dt>
            <dd class="mt-1 text-slate-800">
              {t(locale, 'pages.about.establishedDate')}
            </dd>
          </div>
          <div class="border-l-4 border-brand-500 pl-4">
            <dt class="text-sm font-600 text-slate-500">
              {t(locale, 'pages.about.businessPurposesLabel')}
            </dt>
            <dd class="mt-2">
              <ol class="list-none space-y-2 p-0 text-slate-700">
                {
                  businessPurposes.map((purpose, index) => (
                    <li class="flex gap-2">
                      <>
                        <span>({index + 1})</span>
                        <span>{purpose}</span>
                      </>
                    </li>
                  ))
                }
              </ol>
            </dd>
          </div>
        </dl>
      </section>
      <div class="mb-12">
        <img
          src={optimizeImage(
            'https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=800&h=450&fit=crop&q=80&fm=webp',
            { width: 1200, height: 675, quality: 80 },
          )}
          srcset={generateSrcSet(
            'https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=800&h=450&fit=crop&q=80&fm=webp',
            contentImageWidths,
            contentImageOptions,
          )}
          sizes={contentImageSizes}
          alt={t(locale, 'pages.about.collaborationImgAlt')}
          class="w-full rounded-lg object-cover aspect-video"
          width="1200"
          height="675"
          decoding="async"
          loading="lazy"
        />
      </div>

      {
        officers.length > 0 && (
          <section class="mb-12" aria-labelledby="executive-profile-heading">
            <div class="mb-6">
              <h2 id="executive-profile-heading" class="text-2xl ac-heading">
                {t(locale, 'pages.about.executiveHeading')}
              </h2>
              <p class="mt-2 text-slate-600">
                {t(locale, 'pages.about.executiveLead')}
              </p>
            </div>
            <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {officers.map((officer) => (
                <li>
                  <article class="ac-card h-full p-6">
                    <header class="text-center">
                      <h3 class="text-xl ac-heading">{officer.name}</h3>
                      {officer.role && (
                        <p class="mt-1 text-sm font-700 text-brand-600">
                          {officer.role}
                        </p>
                      )}
                    </header>
                    {(officer.areas?.length || officer.bio) && (
                      <dl class="mt-5 space-y-4 border-t border-slate-200 pt-5 text-left">
                        {officer.areas && officer.areas.length > 0 && (
                          <div>
                            <dt class="text-sm font-700 text-slate-500">
                              {t(locale, 'pages.about.officerAreasLabel')}
                            </dt>
                            <dd class="mt-1 leading-relaxed text-slate-700">
                              {officer.areas.join('・')}
                            </dd>
                          </div>
                        )}
                        {officer.bio && (
                          <div>
                            <dt class="text-sm font-700 text-slate-500">
                              {t(locale, 'pages.about.officerBiographyLabel')}
                            </dt>
                            <dd class="mt-1 whitespace-pre-line leading-relaxed text-slate-600">
                              {officer.bio}
                            </dd>
                          </div>
                        )}
                      </dl>
                    )}
                  </article>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <!-- 理念 -->
      <h2 class="text-2xl ac-heading mb-6">
        {t(locale, 'pages.about.philosophyHeading')}
      </h2>
      <div class="ac-surface mb-12 bg-brand-50 p-8">
        <p class="text-xl font-600 text-brand-700 text-center">
          {t(locale, 'pages.about.philosophyMotto')}
        </p>
      </div>

      <div class="mb-12">
        <img
          src={optimizeImage(
            'https://images.unsplash.com/photo-1531482615713-2afd69097998?w=800&h=450&fit=crop&q=80&fm=webp',
            { width: 1200, height: 675, quality: 80 },
          )}
          srcset={generateSrcSet(
            'https://images.unsplash.com/photo-1531482615713-2afd69097998?w=800&h=450&fit=crop&q=80&fm=webp',
            contentImageWidths,
            contentImageOptions,
          )}
          sizes={contentImageSizes}
          alt={t(locale, 'pages.about.workshopImgAlt')}
          class="w-full rounded-lg object-cover aspect-video"
          width="1200"
          height="675"
          decoding="async"
          loading="lazy"
        />
      </div>

      <div class="text-center">
        <a href={u('/contact/')} class="ac-btn-outline"
          >{t(locale, 'pages.about.corporateContactCta')}</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
