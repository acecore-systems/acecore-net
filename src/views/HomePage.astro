---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import CampaignNotice from '../components/CampaignNotice.astro'
import ServiceCard from '../components/ServiceCard.astro'
import { getCollection } from 'astro:content'
import {
  optimizeImage,
  generateSrcSet,
  resolveImageSource,
  type GenerateSrcSetOptions,
} from '../utils/image'
import {
  t,
  formatDate,
  getLocalizedUrl,
  htmlLangMap,
  type Locale,
} from '../i18n'
import {
  isBasePost,
  localizePost,
  getBaseSlug,
  getLocalizedAuthor,
  filterPostsForLocale,
} from '../utils/blog-i18n'
import { getSchoolsUrl } from '../utils/schools-url'
import { SITE } from '../data/site'
import {
  getAllAuthors,
  findAuthorById,
  type AuthorData,
} from '../utils/authors'

interface Props {
  locale: Locale
}

type BusinessCard = {
  title: string
  description: string
  icon: string
  href: string
  tone: 'brand' | 'emerald' | 'amber' | 'slate'
}

type HeroImage = {
  src: string
  alt: string
  srcsetWidths?: number[]
  srcsetOptions?: GenerateSrcSetOptions
  sizes?: string
}

const { locale } = Astro.props
const u = (path: string) => getLocalizedUrl(path, locale)
const homePath = u('/')
const homeUrl = new URL(homePath, Astro.site).href
const homeHeroSrcSetWidths = [360, 480, 640, 828, 1080, 1280, 1600]
const homeHeroSrcSetOptions = {
  aspectRatio: 1,
  quality: 75,
} satisfies GenerateSrcSetOptions
const homeHeroImageSizes =
  '(min-width: 1280px) 36.5rem, (min-width: 1024px) 40vw, calc(100vw - 2.5rem)'
const homePostImageWidths = [320, 640, 960, 1200]
const homePostImageOptions = { aspectRatio: 16 / 9, quality: 80 }

const allPosts = await getCollection('blog')
const authors: AuthorData[] = await getAllAuthors()
const posts = filterPostsForLocale(
  allPosts.filter(
    (post) => isBasePost(post) && post.data.tags?.includes('お知らせ'),
  ),
  allPosts,
  locale,
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((p) => localizePost(p, allPosts, locale))

const businessCards: BusinessCard[] = [
  {
    title: t(locale, 'pages.home.systemsTitle'),
    description: t(locale, 'pages.home.systemsDescription'),
    href: `${SITE.social.systems}/services/`,
    icon: 'code-xml',
    tone: 'brand',
  },
  {
    title: t(locale, 'pages.home.schoolsTitle'),
    description: t(locale, 'pages.home.schoolsDescription'),
    href: getSchoolsUrl(),
    icon: 'graduation-cap',
    tone: 'amber',
  },
  {
    title: t(locale, 'pages.home.aceserverTitle'),
    description: t(locale, 'pages.home.aceserverDescription'),
    href: SITE.social.aceserver,
    icon: 'gamepad-2',
    tone: 'emerald',
  },
]
const aboutBodyParts = t(locale, 'pages.home.aboutBody2').split('{link}')
const homeHeroImages: HeroImage[] = [
  {
    src: optimizeImage(
      'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=1280&h=1280&fit=crop&q=90&fm=webp',
      { width: 1280, height: 1280, quality: 75 },
    ),
    alt: t(locale, 'pages.home.heroImgTeam'),
    srcsetWidths: homeHeroSrcSetWidths,
    srcsetOptions: homeHeroSrcSetOptions,
    sizes: homeHeroImageSizes,
  },
  {
    src: optimizeImage(
      'https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?w=1280&h=1280&fit=crop&q=90&fm=webp',
      { width: 1280, height: 1280, quality: 75 },
    ),
    alt: t(locale, 'pages.home.heroImgMeeting'),
    srcsetWidths: homeHeroSrcSetWidths,
    srcsetOptions: homeHeroSrcSetOptions,
    sizes: homeHeroImageSizes,
  },
]
const firstHeroImage = homeHeroImages[0]

const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: t(locale, 'meta.siteTitle'),
  description: t(locale, 'meta.defaultDescription'),
  url: homeUrl,
  inLanguage: htmlLangMap[locale],
}
---

<BaseLayout
  locale={locale}
  title={t(locale, 'nav.home')}
  canonicalPath={homePath}
  jsonLd={webPageLd}
  preloadImage={firstHeroImage
    ? {
        src: firstHeroImage.src,
        srcset: generateSrcSet(
          firstHeroImage.src,
          firstHeroImage.srcsetWidths,
          firstHeroImage.srcsetOptions,
        ),
        sizes: firstHeroImage.sizes ?? '100vw',
      }
    : undefined}
>
  <Hero
    title={t(locale, 'pages.home.heroTitle')}
    subtitle={t(locale, 'pages.home.heroSubtitle')}
    showCTA={true}
    images={homeHeroImages}
  />

  <CampaignNotice locale={locale} page="home" />

  <section
    class="ac-blueprint-soft border-y border-brand-100 bg-brand-50/70 pt-14 pb-8 sm:pt-16 sm:pb-10 lg:pt-20 lg:pb-10"
  >
    <div class="ac-container">
      <div class="ac-section-intro">
        <h2 class="mb-4 text-2xl ac-heading sm:text-3xl">
          {t(locale, 'pages.home.businessesHeading')}
        </h2>
        <p class="ac-muted">
          {t(locale, 'pages.home.businessesLead')}
        </p>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          businessCards.map((item) => (
            <ServiceCard
              icon={item.icon}
              title={item.title}
              description={item.description}
              href={item.href}
              locale={locale}
              tone={item.tone}
            />
          ))
        }
      </div>
      <div
        class="mt-8 flex flex-col items-start justify-between gap-3 rounded-lg border border-slate-200 bg-white/70 px-5 py-4 sm:flex-row sm:items-center"
      >
        <div>
          <p class="font-700 text-slate-900">
            {t(locale, 'pages.home.acestudioTitle')}
          </p>
          <p class="mt-1 text-sm leading-relaxed text-slate-600">
            {t(locale, 'pages.home.acestudioNote')}
          </p>
        </div>
        <a href={u('/acestudio/')} class="ac-link shrink-0">
          {t(locale, 'pages.home.acestudioTitle')}
        </a>
      </div>
      <div class="mt-8 text-center">
        <a href={u('/services/')} class="ac-btn-outline"
          >{t(locale, 'pages.home.viewBusinessDetails')}</a
        >
      </div>
    </div>
  </section>

  <section class="ac-section bg-brand-900 text-white">
    <div class="ac-container">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="mb-6 text-2xl font-800 leading-tight text-white sm:text-3xl">
          {t(locale, 'pages.home.aboutHeading')}
        </h2>
        <p class="text-lg leading-relaxed text-white/80 mb-4">
          {t(locale, 'pages.home.aboutBody1')}
        </p>
        <p class="text-lg leading-relaxed text-white/80 mb-8">
          {
            aboutBodyParts.map((part, index) => (
              <>
                {part}
                {index < aboutBodyParts.length - 1 && (
                  <a
                    href={getSchoolsUrl()}
                    class="text-white underline underline-offset-2 hover:text-brand-100"
                  >
                    {t(locale, 'pages.home.aboutEducationLink')}
                  </a>
                )}
              </>
            ))
          }
        </p>
        <div
          class="flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4"
        >
          <a href={u('/about/')} class="ac-btn-primary"
            >{t(locale, 'pages.home.viewAbout')}</a
          >
        </div>
      </div>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="border-b border-brand-100 bg-white py-8 sm:py-10">
        <div class="ac-container">
          <div class="ac-section-intro">
            <h2 class="text-2xl ac-heading sm:text-3xl">
              {t(locale, 'pages.home.latestNews')}
            </h2>
          </div>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
            {posts.map((post) => {
              const postImage = resolveImageSource(
                post.data.uploadedImage,
                post.data.image,
              )
              const rawAuthor = findAuthorById(authors, post.data.author)
              const author = rawAuthor
                ? getLocalizedAuthor(rawAuthor, locale)
                : null

              return (
                <a
                  href={u(`/blog/${getBaseSlug(post.id)}/`)}
                  class="ac-card ac-rule-top group overflow-hidden pt-0 no-underline transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-[0_18px_38px_rgba(15,35,56,0.1)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2"
                >
                  {postImage && (
                    <img
                      src={optimizeImage(postImage, {
                        width: 800,
                        height: 400,
                        quality: 80,
                      })}
                      srcset={generateSrcSet(
                        postImage,
                        homePostImageWidths,
                        homePostImageOptions,
                      )}
                      sizes="(min-width: 768px) calc(33vw - 2rem), calc(100vw - 2rem)"
                      alt={post.data.title}
                      class="h-44 w-full object-cover"
                      width="800"
                      height="400"
                      decoding="async"
                      loading="lazy"
                    />
                  )}
                  <div class="p-6">
                    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-slate-600">
                      <time datetime={post.data.date.toISOString()}>
                        {formatDate(post.data.date, locale)}
                      </time>
                      {post.data.author && (
                        <span>by {author?.name || post.data.author}</span>
                      )}
                    </div>
                    <h3 class="mt-3 mb-3 text-lg font-700 leading-snug text-slate-900 transition-colors group-hover:text-brand-600">
                      {post.data.title}
                    </h3>
                    <p class="line-clamp-3 text-sm leading-relaxed text-slate-600">
                      {post.data.description}
                    </p>
                  </div>
                </a>
              )
            })}
          </div>
          <div class="mt-10 text-center">
            <a href={u('/blog/')} class="ac-btn-outline">
              {t(locale, 'pages.home.viewAllNews')}
            </a>
          </div>
        </div>
      </section>
    )
  }

  <section class="ac-section bg-brand-50">
    <div class="ac-container max-w-3xl text-center">
      <h2 class="mb-4 text-2xl ac-heading sm:text-3xl">
        {t(locale, 'pages.home.contactHeading')}
      </h2>
      <p class="mx-auto mb-7 max-w-2xl ac-muted">
        {t(locale, 'pages.home.contactBody')}
      </p>
      <a href={u('/contact/')} class="ac-btn-primary">
        {t(locale, 'pages.home.contactCta')}
      </a>
    </div>
  </section>
</BaseLayout>
