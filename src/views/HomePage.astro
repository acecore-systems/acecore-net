---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import CampaignNotice from '../components/CampaignNotice.astro'
import BusinessDepartments from '../components/BusinessDepartments.astro'
import Icon from '../components/Icon.astro'
import { getCollection } from 'astro:content'
import { SITE } from '../data/site'
import {
  t,
  getLocalizedUrl,
  formatDate,
  htmlLangMap,
  type Locale,
} from '../i18n'
import {
  filterPostsForLocale,
  isBasePost,
  localizePost,
  getBaseSlug,
} from '../utils/blog-i18n'
interface Props {
  locale: Locale
}
const { locale } = Astro.props
const u = (path: string) => getLocalizedUrl(path, locale)
const allPosts = await getCollection('blog')
const posts = filterPostsForLocale(
  allPosts.filter(
    (post) => isBasePost(post) && post.data.tags?.includes('お知らせ'),
  ),
  allPosts,
  locale,
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((p) => localizePost(p, allPosts, locale))
const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: t(locale, 'meta.siteTitle'),
  description: t(locale, 'meta.defaultDescription'),
  url: SITE.url + u('/'),
  inLanguage: htmlLangMap[locale],
}
---

<BaseLayout
  locale={locale}
  title={t(locale, 'nav.home')}
  canonicalPath={u('/')}
  jsonLd={webPageLd}
>
  <Hero
    title={t(locale, 'pages.home.heroTitle')}
    titleLines={locale === 'ja'
      ? t(locale, 'pages.home.heroTitle').split(/(?<=、)/)
      : undefined}
    subtitle={t(locale, 'pages.home.heroSubtitle')}
    showCTA
    locale={locale}
  />
  <CampaignNotice locale={locale} page="home" />
  <section
    class="ac-section home-business"
    aria-labelledby="home-business-heading"
  >
    <div class="ac-container">
      <div class="home-section-heading">
        <h2 id="home-business-heading" class="ac-section-title">
          {t(locale, 'nav.services')}
        </h2>
        <a
          href={u('/services/')}
          class="ac-text-link inline-flex items-center gap-3"
        >
          {t(locale, 'pages.home.viewBusinessDetails')}<Icon
            name="arrow-right"
          />
        </a>
      </div>
      <BusinessDepartments locale={locale} />
    </div>
  </section>
  {
    posts.length > 0 && (
      <section class="ac-section home-news" aria-labelledby="home-news-heading">
        <div class="ac-container ac-editorial">
          <h2 id="home-news-heading" class="ac-section-title">
            {t(locale, 'nav.blog')}
          </h2>
          <div>
            <ul class="news-list divide-y divide-slate-200">
              {posts.map((post) => (
                <li>
                  <a
                    href={u(`/blog/${getBaseSlug(post.id)}/`)}
                    class="news-row"
                  >
                    <time datetime={post.data.date.toISOString()}>
                      {formatDate(post.data.date, locale)}
                    </time>
                    <span>{post.data.title}</span>
                    <Icon name="arrow-right" />
                  </a>
                </li>
              ))}
            </ul>
            <a href={u('/blog/')} class="ac-text-link mt-6 inline-flex">
              {t(locale, 'pages.home.viewAllNews')}
            </a>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
