---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import CampaignNotice from '../components/CampaignNotice.astro'
import BrandName from '../components/BrandName.astro'
import BrandImage from '../components/BrandImage.astro'
import ArrowLink from '../components/ArrowLink.astro'
import ContactBand from '../components/ContactBand.astro'
import Icon from '../components/Icon.astro'
import { castScene, castSceneAsset } from '../data/cast-scenes'
import { getCollection } from 'astro:content'
import {
  t,
  formatDate,
  getLocalizedUrl,
  htmlLangMap,
  type Locale,
} from '../i18n'
import {
  isBasePost,
  localizePost,
  getBaseSlug,
  getLocalizedAuthor,
  filterPostsForLocale,
} from '../utils/blog-i18n'
import { getAllAuthors, findAuthorById } from '../utils/authors'
interface Props {
  locale: Locale
}
const { locale } = Astro.props
const u = (path: string) => getLocalizedUrl(path, locale)
const homeTitle = t(locale, 'pages.home.heroTitle')
const allPosts = await getCollection('blog')
const authors = await getAllAuthors()
const posts = filterPostsForLocale(
  allPosts.filter(
    (post) => isBasePost(post) && post.data.tags?.includes('お知らせ'),
  ),
  allPosts,
  locale,
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((p) => localizePost(p, allPosts, locale))
const heroImages = [
  { stem: 'home-team', alt: 'heroImgTeam' },
  { stem: 'home-meeting', alt: 'heroImgMeeting' },
].map(({ stem, alt }) => ({
  src: castScene(stem),
  alt: t(locale, 'pages.home.' + alt),
  width: castSceneAsset(stem).width,
  height: castSceneAsset(stem).height,
  srcsetWidths: [castSceneAsset(stem).width],
  sizes: '(min-width: 792px) 760px, calc(100vw - 32px)',
}))
const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: t(locale, 'meta.siteTitle'),
  description: t(locale, 'meta.defaultDescription'),
  url: new URL(u('/'), Astro.site).href,
  inLanguage: htmlLangMap[locale],
}
---

<BaseLayout
  locale={locale}
  title={t(locale, 'nav.home')}
  canonicalPath={u('/')}
  jsonLd={webPageLd}
>
  <Hero
    title={homeTitle}
    titleLines={
      locale === 'ja' && homeTitle === '世界を次のステージへ'
        ? ['世界を', '次のステージへ']
        : undefined
    }
    subtitle={t(locale, 'pages.home.heroSubtitle')}
    locale={locale}
    images={heroImages}
  >
    <ArrowLink
      slot="actions"
      href={u('/services/')}
      locale={locale}
      eventLabel="hero_services"
      location="hero"
    >
      {t(locale, 'pages.home.viewBusinessDetails')}
    </ArrowLink>
  </Hero>
  <CampaignNotice locale={locale} page="home" />
  <section
    class="ac-section home-business"
    aria-labelledby="home-business-heading"
  >
    <div class="ac-container ac-editorial">
      <div class="ac-section-lead">
        <h2 id="home-business-heading" class="ac-section-title">
          {t(locale, 'pages.home.servicesHeading')}
        </h2>
        <p class="mt-5 ac-muted">{t(locale, 'pages.home.servicesIntro')}</p>
        <ArrowLink
          href={u('/services/')}
          locale={locale}
          eventLabel={t(locale, 'pages.home.servicesHeading')}
          location="service_card"
        >
          {t(locale, 'pages.home.viewBusinessDetails')}
        </ArrowLink>
      </div>
      <div class="home-department-preview">
        {['systems', 'schools', 'design'].map((key) => (
          <a
            href={u('/services/') + '#' + key}
            class="home-department-row"
            data-department={key === 'design' ? 'designs' : key}
            data-ga-event="cta_click"
            data-ga-label={t(locale, 'pages.services.' + key + 'Title')}
            data-ga-location="home_business_preview"
            data-ga-destination={u('/services/') + '#' + key}
          >
            <div>
              <h3>
                <BrandName
                  name={t(locale, 'pages.services.' + key + 'Title')}
                />
              </h3>
              <p>{t(locale, 'pages.services.' + key + 'Description')}</p>
            </div>
            <span class="ac-arrow-circle" aria-hidden="true">
              <Icon name="arrow-right" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="home-company" aria-labelledby="home-company-heading">
    <div class="ac-container home-company-layout">
      <figure>
        <BrandImage
          name="collaboration"
          alt={t(locale, 'pages.home.companyImageAlt')}
        />
        <figcaption>{t(locale, 'pages.home.companyImageCaption')}</figcaption>
      </figure>
      <div>
        <h2 id="home-company-heading" class="ac-section-title">
          {t(locale, 'nav.about')}
        </h2>
        <p class="mt-6 leading-loose">{t(locale, 'pages.home.aboutIntro')}</p>
        <ArrowLink
          href={u('/about/')}
          locale={locale}
          eventLabel={t(locale, 'nav.about')}
          location="service_card"
        >
          {t(locale, 'pages.home.viewAbout')}
        </ArrowLink>
      </div>
    </div>
  </section>
  {posts.length > 0 && (
    <section class="ac-section home-news">
      <div class="ac-container ac-editorial">
        <h2 class="ac-section-title">
          {locale === 'ja' &&
          t(locale, 'pages.home.latestNews') === '企業ニュース' ? (
            <>
              <span class="home-news-title-line">企業</span>
              <span class="home-news-title-line">ニュース</span>
            </>
          ) : (
            t(locale, 'pages.home.latestNews')
          )}
        </h2>
        <div>
          <div class="home-news-list">
            {posts.map((post) => {
              const rawAuthor = findAuthorById(authors, post.data.author)
              const author = rawAuthor
                ? getLocalizedAuthor(rawAuthor, locale)
                : null
              return (
                <a
                  href={u('/blog/' + getBaseSlug(post.id) + '/')}
                  class="home-news-row"
                >
                  <div>
                    <div class="home-news-meta">
                      <time datetime={post.data.date.toISOString()}>
                        {formatDate(post.data.date, locale)}
                      </time>
                      {post.data.author && (
                        <span>by {author?.name || post.data.author}</span>
                      )}
                    </div>
                    <h3>{post.data.title}</h3>
                  </div>
                  <span class="ac-arrow-circle" aria-hidden="true">
                    <Icon name="arrow-right" />
                  </span>
                </a>
              )
            })}
          </div>
          <div class="mt-8 flex justify-end">
            <ArrowLink href={u('/blog/')} locale={locale}>
              {t(locale, 'pages.home.viewAllNews')}
            </ArrowLink>
          </div>
        </div>
      </div>
    </section>
  )}
  <ContactBand locale={locale} />
</BaseLayout>
