---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import ServiceCard from '../components/ServiceCard.astro'
import { SITE } from '../data/site'
import { optimizeImage } from '../utils/image'
import { t, getLocalizedUrl, type Locale } from '../i18n'
import { getSchoolsUrl } from '../utils/schools-url'
import { getSpecialistUrl } from '../utils/specialist-url'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const u = (path: string) => getLocalizedUrl(path, locale)
const destinations = [
  {
    title: t(locale, 'pages.pricing.systemsTitle'),
    description: t(locale, 'pages.pricing.systemsBody'),
    href: getSpecialistUrl(SITE.social.systems, locale, '/pricing/'),
    icon: 'code-xml',
    tone: 'brand' as const,
  },
  {
    title: t(locale, 'pages.pricing.schoolsTitle'),
    description: t(locale, 'pages.pricing.schoolsBody'),
    href: getSchoolsUrl('/pricing/'),
    icon: 'graduation-cap',
    tone: 'amber' as const,
  },
  {
    title: t(locale, 'pages.pricing.aceserverTitle'),
    description: t(locale, 'pages.pricing.aceserverBody'),
    href: getSpecialistUrl(SITE.social.aceserver, locale),
    icon: 'gamepad-2',
    tone: 'emerald' as const,
  },
  {
    title: t(locale, 'pages.pricing.shopTitle'),
    description: t(locale, 'pages.pricing.shopBody'),
    href: SITE.social.shop,
    icon: 'shopping-bag',
    tone: 'slate' as const,
  },
  {
    title: t(locale, 'pages.pricing.contactTitle'),
    description: t(locale, 'pages.pricing.contactBody'),
    href: u('/contact/'),
    icon: 'messages-square',
    tone: 'slate' as const,
  },
]
---

<BaseLayout
  title={t(locale, 'pages.pricing.title')}
  description={t(locale, 'pages.pricing.description')}
  locale={locale}
>
  <Hero
    title={t(locale, 'pages.pricing.heroTitle')}
    subtitle={t(locale, 'pages.pricing.heroSubtitle')}
    images={[
      {
        src: optimizeImage(
          'https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=1400&h=600&fit=crop&q=80&fm=webp',
        ),
        alt: t(locale, 'pages.pricing.heroImgAlt'),
      },
    ]}
  />

  <section class="ac-section bg-slate-50">
    <div class="ac-container max-w-5xl">
      <Breadcrumb
        items={[{ label: t(locale, 'pages.pricing.title') }]}
        locale={locale}
      />

      <div class="ac-section-intro">
        <p class="ac-eyebrow">{t(locale, 'pages.pricing.eyebrow')}</p>
        <h2 class="mb-4 text-2xl ac-heading sm:text-3xl">
          {t(locale, 'pages.pricing.introTitle')}
        </h2>
        <p class="max-w-3xl ac-muted">
          {t(locale, 'pages.pricing.introBody')}
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          destinations.map((destination) => (
            <ServiceCard
              icon={destination.icon}
              title={destination.title}
              description={destination.description}
              href={destination.href}
              locale={locale}
              tone={destination.tone}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
