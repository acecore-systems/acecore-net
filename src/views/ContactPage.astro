---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/Hero.astro'
import CampaignNotice from '../components/CampaignNotice.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import Icon from '../components/Icon.astro'
import { optimizeImage } from '../utils/image'
import { SITE } from '../data/site'
import { t, getLocalizedUrl, type Locale } from '../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const u = (path: string) => getLocalizedUrl(path, locale)
const organizationId = `${SITE.url}/#organization`
const contactThanksUrl = u('/contact/thanks/')

const serviceCategoryOptions = [
  {
    key: 'systems',
    value: '業務システム・Webアプリ開発について',
    label: t(locale, 'pages.contact.formCategoryServiceSystems'),
    subject: t(locale, 'pages.services.systemsTitle'),
  },
  {
    key: 'education',
    value: 'ITスクール / Acecore Schoolsについて',
    label: t(locale, 'pages.contact.formCategoryServiceEducation'),
    subject: t(locale, 'pages.services.schoolsTitle'),
  },
  {
    key: 'aceserver',
    value: 'Aceserverについて',
    label: t(locale, 'pages.contact.formCategoryServiceAceserver'),
    subject: t(locale, 'pages.services.aceserverTitle'),
  },
  {
    key: 'acestudio',
    value: 'AceStudioについて',
    label: t(locale, 'pages.contact.formCategoryServiceAcestudio'),
    subject: t(locale, 'pages.services.acestudioTitle'),
  },
]

const contactPageLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `${t(locale, 'pages.contact.title')} | Acecore`,
  description: t(locale, 'pages.contact.description'),
  url: `${SITE.url}${u('/contact/')}`,
  mainEntity: { '@id': organizationId },
}
---

<BaseLayout
  title={t(locale, 'pages.contact.title')}
  titleContext={t(locale, 'pages.contact.seoTitleContext')}
  description={t(locale, 'pages.contact.description')}
  jsonLd={contactPageLd}
  locale={locale}
>
  <Hero
    title={t(locale, 'pages.contact.heroTitle')}
    subtitle={t(locale, 'pages.contact.heroSubtitle')}
    images={[
      {
        src: optimizeImage(
          'https://images.unsplash.com/photo-1423666639041-f56000c27a9a?w=1400&h=600&fit=crop&q=80&fm=webp',
        ),
        alt: t(locale, 'pages.contact.heroImgAlt'),
      },
    ]}
  />

  <CampaignNotice locale={locale} page="contact" />

  <section class="ac-section">
    <div class="ac-container max-w-2xl">
      <Breadcrumb
        items={[{ label: t(locale, 'pages.contact.title') }]}
        locale={locale}
      />
      <section
        class="mb-10 rounded-lg border border-brand-100 bg-brand-50 p-5"
        aria-labelledby="ai-contact-heading"
      >
        <div
          class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
        >
          <div class="flex items-start gap-3">
            <span class="ac-icon-box shrink-0">
              <Icon name="sparkles" class="text-lg" />
            </span>
            <div>
              <h2 id="ai-contact-heading" class="text-lg ac-heading">
                {t(locale, 'pages.contact.aiHeading')}
              </h2>
              <p class="mt-1 text-sm leading-relaxed text-slate-600">
                {t(locale, 'pages.contact.aiLead')}
              </p>
            </div>
          </div>
          <button
            type="button"
            class="ac-btn-primary shrink-0"
            data-ace-chat-open
            data-ga-event="ai_chat_open_click"
            data-ga-label="contact_ai_chat"
            data-ga-location="contact_ai_assist"
          >
            <Icon name="bot-message-square" class="text-base" />
            {t(locale, 'pages.contact.aiSubmit')}
          </button>
        </div>
      </section>

      <form
        id="contact-form"
        action="/api/contact"
        method="post"
        class="space-y-6"
        data-t-sending={t(locale, 'pages.contact.formSending')}
        data-t-success={t(locale, 'pages.contact.formSuccess')}
        data-t-error={t(locale, 'pages.contact.formError')}
        data-t-validation-category={t(
          locale,
          'pages.contact.validationCategory',
        )}
        data-t-validation-name={t(locale, 'pages.contact.validationName')}
        data-t-validation-email={t(locale, 'pages.contact.validationEmail')}
        data-t-validation-message={t(locale, 'pages.contact.validationMessage')}
        data-success-url={contactThanksUrl}
        data-service-subject-template={t(
          locale,
          'pages.contact.serviceSubjectTemplate',
        )}
      >
        <input type="hidden" name="locale" value={locale} />
        <input
          type="text"
          name="company_website"
          autocomplete="off"
          tabindex="-1"
          class="hidden"
          aria-hidden="true"
        />
        <div>
          <label
            for="category"
            class="block text-sm font-600 text-slate-700 mb-2"
          >
            {t(locale, 'pages.contact.formCategoryLabel')}
            <span class="text-red-500" aria-hidden="true">*</span><span
              class="sr-only">{t(locale, 'common.required')}</span
            >
          </label>
          <select
            id="category"
            name="お問い合わせ種別"
            required
            class="ac-input"
          >
            <option value="" disabled selected
              >{t(locale, 'pages.contact.formCategoryPlaceholder')}</option
            >
            <option value="サービス全般について"
              >{t(locale, 'pages.contact.formCategoryService')}</option
            >
            {
              serviceCategoryOptions.map((option) => (
                <option
                  value={option.value}
                  data-service-key={option.key}
                  data-service-subject={option.subject}
                >
                  {option.label}
                </option>
              ))
            }
            <option value="お見積り依頼"
              >{t(locale, 'pages.contact.formCategoryEstimate')}</option
            >
            <option value="パートナーシップ"
              >{t(locale, 'pages.contact.formCategoryPartnership')}</option
            >
            <option value="採用について"
              >{t(locale, 'pages.contact.formCategoryRecruit')}</option
            >
            <option value="その他"
              >{t(locale, 'pages.contact.formCategoryOther')}</option
            >
          </select>
          <p
            class="text-xs text-red-600 mt-1 hidden"
            id="category-error"
            role="alert"
          >
          </p>
        </div>
        <div>
          <label for="name" class="block text-sm font-600 text-slate-700 mb-2">
            {t(locale, 'pages.contact.formNameLabel')}
            <span class="text-red-500" aria-hidden="true">*</span><span
              class="sr-only">{t(locale, 'common.required')}</span
            >
          </label>
          <input
            type="text"
            id="name"
            name="お名前"
            required
            autocomplete="name"
            class="ac-input"
          />
          <p
            class="text-xs text-red-600 mt-1 hidden"
            id="name-error"
            role="alert"
          >
          </p>
        </div>
        <div>
          <label for="email" class="block text-sm font-600 text-slate-700 mb-2">
            {t(locale, 'pages.contact.formEmailLabel')}
            <span class="text-red-500" aria-hidden="true">*</span><span
              class="sr-only">{t(locale, 'common.required')}</span
            >
          </label>
          <input
            type="email"
            id="email"
            name="メールアドレス"
            required
            autocomplete="email"
            class="ac-input"
          />
          <p
            class="text-xs text-red-600 mt-1 hidden"
            id="email-error"
            role="alert"
          >
          </p>
        </div>
        <div>
          <label
            for="subject"
            class="block text-sm font-600 text-slate-700 mb-2"
          >
            {t(locale, 'pages.contact.formSubjectLabel')}
          </label>
          <input type="text" id="subject" name="件名" class="ac-input" />
        </div>
        <div>
          <label
            for="message"
            class="block text-sm font-600 text-slate-700 mb-2"
          >
            {t(locale, 'pages.contact.formMessageLabel')}
            <span class="text-red-500" aria-hidden="true">*</span><span
              class="sr-only">{t(locale, 'common.required')}</span
            >
          </label>
          <textarea
            id="message"
            name="お問い合わせ内容"
            rows="6"
            required
            class="ac-input resize-y"></textarea>
          <p
            class="text-xs text-red-600 mt-1 hidden"
            id="message-error"
            role="alert"
          >
          </p>
        </div>
        <div
          id="turnstile-widget"
          class="cf-turnstile"
          data-sitekey={SITE.turnstileSiteKey}
          data-language={locale}
          data-theme="light"
        >
        </div>
        <div>
          <button
            type="submit"
            id="contact-submit"
            class="ac-btn-primary w-full sm:w-auto disabled:opacity-50 disabled:cursor-not-allowed"
          >
            {t(locale, 'pages.contact.formSubmit')}
          </button>
          <p class="text-xs text-slate-600 mt-3">
            {t(locale, 'pages.contact.formSubmitNote')}
          </p>
        </div>
        <div
          id="form-feedback"
          class="hidden rounded-lg p-4 text-sm"
          role="alert"
          aria-live="polite"
        >
        </div>
      </form>
    </div>
  </section>

  <script is:inline>
    function initContactTurnstile() {
      const turnstileEl = document.getElementById('turnstile-widget')
      if (!turnstileEl) return

      if (turnstileEl.dataset.widgetId) return

      const sitekey = turnstileEl.dataset.sitekey
      const language = turnstileEl.dataset.language
      const theme = turnstileEl.dataset.theme || 'light'

      if (!sitekey) return

      function renderTurnstile() {
        if (
          typeof window.turnstile === 'undefined' ||
          turnstileEl.dataset.widgetId
        ) {
          return
        }

        const widgetId = window.turnstile.render(turnstileEl, {
          sitekey,
          language,
          theme,
        })
        turnstileEl.dataset.widgetId = String(widgetId)
      }

      if (typeof window.turnstile !== 'undefined') {
        renderTurnstile()
        return
      }

      const existingScript = document.querySelector(
        'script[data-ace-turnstile-script]',
      )

      if (existingScript) {
        let attempts = 0
        const waitForTurnstile = function () {
          if (typeof window.turnstile !== 'undefined') {
            renderTurnstile()
            return
          }
          if (attempts >= 50) return
          attempts += 1
          window.setTimeout(waitForTurnstile, 100)
        }
        waitForTurnstile()
        return
      }

      const script = document.createElement('script')
      script.dataset.aceTurnstileScript = 'true'
      script.src =
        'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit'
      script.async = true
      script.addEventListener('load', renderTurnstile, { once: true })
      document.head.appendChild(script)
    }

    document.addEventListener('astro:page-load', initContactTurnstile)
    initContactTurnstile()
  </script>
  <script is:inline>
    function initContactServicePrefill() {
      const form = document.getElementById('contact-form')
      if (!form || form.dataset.servicePrefillInitialized === 'true') return

      form.dataset.servicePrefillInitialized = 'true'

      const url = new URL(window.location.href)
      const requestedCategory = url.searchParams.get('category')
      const requestedService = url.searchParams.get('service') || ''
      const serviceAliases = {
        server: 'systems',
        web: 'systems',
        design: 'systems',
      }
      const normalizedService =
        serviceAliases[requestedService] || requestedService
      const category = document.getElementById('category')
      const subject = document.getElementById('subject')

      if (
        requestedCategory === 'service' &&
        category instanceof HTMLSelectElement
      ) {
        const serviceOption = Array.from(category.options).find(
          function (option) {
            return option.dataset.serviceKey === normalizedService
          },
        )

        category.value = serviceOption?.value || 'サービス全般について'
        category.dispatchEvent(new Event('input', { bubbles: true }))
        category.dispatchEvent(new Event('change', { bubbles: true }))
        if (
          serviceOption &&
          subject instanceof HTMLInputElement &&
          !subject.value.trim()
        ) {
          const template = form.dataset.serviceSubjectTemplate || '{service}'
          const serviceName =
            serviceOption.dataset.serviceSubject ||
            serviceOption.textContent?.trim() ||
            ''
          subject.value = template.replace('{service}', serviceName)
        }
      }

      if (window.location.hash === '#contact-form') {
        window.requestAnimationFrame(function () {
          form.scrollIntoView({ block: 'start' })
        })
      }
    }

    document.addEventListener('astro:page-load', initContactServicePrefill)
    initContactServicePrefill()
  </script>
  <script is:inline>
    {
      const contactForm = document.getElementById('contact-form')
      const vCat = contactForm?.getAttribute('data-t-validation-category') || ''
      const vName = contactForm?.getAttribute('data-t-validation-name') || ''
      const vEmail = contactForm?.getAttribute('data-t-validation-email') || ''
      const vMsg = contactForm?.getAttribute('data-t-validation-message') || ''
      const minMessageMeaningfulLength = 10
      function countMeaningfulCharacters(value) {
        return Array.from(value.replace(/[^\p{L}\p{N}]/gu, '')).length
      }
      const rules = {
        category: function (v) {
          return v ? '' : vCat
        },
        name: function (v) {
          return v.trim() ? '' : vName
        },
        email: function (v) {
          return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) ? '' : vEmail
        },
        message: function (v) {
          return countMeaningfulCharacters(v) >= minMessageMeaningfulLength
            ? ''
            : vMsg
        },
      }
      function showError(id, msg) {
        const el = document.getElementById(id + '-error')
        const input = document.getElementById(id)
        if (!el || !input) return
        if (msg) {
          el.textContent = msg
          el.classList.remove('hidden')
          input.classList.add('border-red-400')
          input.setAttribute('aria-invalid', 'true')
          input.setAttribute('aria-describedby', id + '-error')
        } else {
          el.textContent = ''
          el.classList.add('hidden')
          input.classList.remove('border-red-400')
          input.removeAttribute('aria-invalid')
          input.removeAttribute('aria-describedby')
        }
      }
      function validateField(id) {
        var el = document.getElementById(id)
        if (!el) return ''
        var msg = rules[id](el.value)
        showError(id, msg)
        return msg
      }
      function validateForm() {
        var firstInvalid = null
        Object.keys(rules).forEach(function (id) {
          var el = document.getElementById(id)
          if (!el) return
          if (validateField(id) && !firstInvalid) {
            firstInvalid = el
          }
        })
        if (firstInvalid) firstInvalid.focus()
        return !firstInvalid
      }
      Object.keys(rules).forEach(function (id) {
        var el = document.getElementById(id)
        if (el) {
          el.addEventListener('blur', function () {
            validateField(id)
          })
          el.addEventListener('input', function () {
            if (el.getAttribute('aria-invalid')) validateField(id)
          })
        }
      })
      contactForm?.addEventListener('submit', function (event) {
        if (!validateForm()) {
          event.preventDefault()
          event.stopImmediatePropagation()
        }
      })
    }
  </script>
  <script is:inline>
    {
      const form = document.getElementById('contact-form')
      if (form) {
        const feedback = document.getElementById('form-feedback')
        const errorText = form.getAttribute('data-t-error') || 'Failed to send.'
        const successText =
          form.getAttribute('data-t-success') || 'Message sent.'
        const successUrl =
          form.getAttribute('data-success-url') || '/contact/thanks/'

        function showFeedback(type, text) {
          if (!feedback) return
          feedback.textContent = text
          feedback.className =
            type === 'success'
              ? 'rounded-lg p-4 text-sm bg-emerald-50 text-emerald-800 border border-emerald-200'
              : 'rounded-lg p-4 text-sm bg-red-50 text-red-800 border border-red-200'
        }

        function resetTurnstile() {
          const turnstileEl = document.getElementById('turnstile-widget')
          const widgetId = turnstileEl?.dataset.widgetId
          if (typeof turnstile !== 'undefined' && widgetId) {
            turnstile.reset(widgetId)
          }
        }

        const currentUrl = new URL(window.location.href)
        const contactState = currentUrl.searchParams.get('contact')
        if (contactState === 'sent') {
          window.location.replace(successUrl)
        } else if (contactState === 'error') {
          showFeedback('error', errorText)
          currentUrl.searchParams.delete('contact')
          window.history.replaceState({}, '', currentUrl)
        }

        form.addEventListener('submit', function (e) {
          e.preventDefault()
          const formData = new FormData(form)
          const btn = document.getElementById('contact-submit')
          if (!btn || !feedback) return
          const sendingText = form.getAttribute('data-t-sending') || 'Sending…'
          const originalText = btn.textContent
          btn.disabled = true
          btn.textContent = sendingText
          feedback.className = 'hidden rounded-lg p-4 text-sm'
          fetch(form.action, {
            method: 'POST',
            headers: {
              Accept: 'application/json',
            },
            body: formData,
          })
            .then(async function (res) {
              if (!res.ok) {
                throw new Error('Failed')
              }
              if (window.aceTrackEvent) {
                window.aceTrackEvent('generate_lead', {
                  page_path: window.location.pathname,
                  page_title: document.title,
                  location: 'contact_form',
                  contact_category: String(
                    formData.get('お問い合わせ種別') || '',
                  ),
                })
              }
              if (successUrl) {
                window.location.assign(successUrl)
              } else {
                showFeedback('success', successText)
                form.reset()
                resetTurnstile()
              }
            })
            .catch(function () {
              showFeedback('error', errorText)
              resetTurnstile()
            })
            .finally(function () {
              btn.disabled = false
              btn.textContent = originalText
            })
        })
      }
    }
  </script>
</BaseLayout>
