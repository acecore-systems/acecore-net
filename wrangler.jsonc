{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "acecore-net",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-07-27",
  "ai": {
    "binding": "AI",
  },
  "vectorize": [
    {
      "binding": "SEARCH_INDEX",
      "index_name": "acecore-net-search-preview",
    },
  ],
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "db9b62f409f463da7acbcc374b8385d0",
    "CLOUDFLARE_AI_MODEL": "@cf/zai-org/glm-5.2",
    "CLOUDFLARE_AI_REASONING_EFFORT": "low",
    "COMMENT_ALLOWED_HOSTNAMES": "acecore.net,www.acecore.net,acecore-net.pages.dev,localhost,127.0.0.1",
    "CONTACT_FROM_EMAIL": "noreply@acecore.net",
    "CONTACT_TO_EMAIL": "info@acecore.net",
    "CONTACT_ALLOWED_HOSTNAMES": "acecore.net,www.acecore.net,acecore-net.pages.dev,localhost,127.0.0.1",
    "SEARCH_ENABLED": "true",
    "SEARCH_MIN_SCORE": "0.50",
  },
  "d1_databases": [
    {
      "binding": "COMMENTS_DB",
      "database_name": "acecore-comments",
      "database_id": "3f31c39c-e418-4460-8651-4385e0409157",
      "migrations_dir": "./migrations",
    },
    {
      "binding": "SEARCH_RATE_LIMIT_DB",
      "database_name": "acecore-net-search-preview",
      "database_id": "e249ebf7-218d-4baf-b732-c0c2580141f5",
      "migrations_dir": "./migrations/search",
    },
  ],
  "env": {
    "preview": {
      "ai": {
        "binding": "AI",
      },
      "vectorize": [
        {
          "binding": "SEARCH_INDEX",
          "index_name": "acecore-net-search-preview",
        },
      ],
      "vars": {
        "CLOUDFLARE_ACCOUNT_ID": "db9b62f409f463da7acbcc374b8385d0",
        "CLOUDFLARE_AI_MODEL": "@cf/zai-org/glm-5.2",
        "CLOUDFLARE_AI_REASONING_EFFORT": "low",
        "COMMENT_ALLOWED_HOSTNAMES": "acecore.net,www.acecore.net,acecore-net.pages.dev",
        "CONTACT_FROM_EMAIL": "noreply@acecore.net",
        "CONTACT_TO_EMAIL": "info@acecore.net",
        "CONTACT_ALLOWED_HOSTNAMES": "acecore.net,www.acecore.net,acecore-net.pages.dev",
        "SEARCH_ENABLED": "true",
        "SEARCH_MIN_SCORE": "0.50",
      },
      "d1_databases": [
        {
          "binding": "COMMENTS_DB",
          "database_name": "acecore-comments",
          "database_id": "3f31c39c-e418-4460-8651-4385e0409157",
          "migrations_dir": "./migrations",
        },
        {
          "binding": "SEARCH_RATE_LIMIT_DB",
          "database_name": "acecore-net-search-preview",
          "database_id": "e249ebf7-218d-4baf-b732-c0c2580141f5",
          "migrations_dir": "./migrations/search",
        },
      ],
    },
    "production": {
      "ai": {
        "binding": "AI",
      },
      "vectorize": [
        {
          "binding": "SEARCH_INDEX",
          "index_name": "acecore-net-search-production",
        },
      ],
      "vars": {
        "CLOUDFLARE_ACCOUNT_ID": "db9b62f409f463da7acbcc374b8385d0",
        "CLOUDFLARE_AI_MODEL": "@cf/zai-org/glm-5.2",
        "CLOUDFLARE_AI_REASONING_EFFORT": "low",
        "COMMENT_ALLOWED_HOSTNAMES": "acecore.net,www.acecore.net,acecore-net.pages.dev",
        "CONTACT_FROM_EMAIL": "noreply@acecore.net",
        "CONTACT_TO_EMAIL": "info@acecore.net",
        "CONTACT_ALLOWED_HOSTNAMES": "acecore.net,www.acecore.net,acecore-net.pages.dev",
        "SEARCH_ENABLED": "true",
        "SEARCH_MIN_SCORE": "0.50",
      },
      "d1_databases": [
        {
          "binding": "COMMENTS_DB",
          "database_name": "acecore-comments",
          "database_id": "3f31c39c-e418-4460-8651-4385e0409157",
          "migrations_dir": "./migrations",
        },
        {
          "binding": "SEARCH_RATE_LIMIT_DB",
          "database_name": "acecore-net-search-production",
          "database_id": "3d26157c-b052-498c-af9b-82bad65b8421",
          "migrations_dir": "./migrations/search",
        },
      ],
    },
  },
}
