{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "acecore-net",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-07-27",
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "db9b62f409f463da7acbcc374b8385d0",
    "WORKERS_AI_CHAT_MODEL": "@cf/zai-org/glm-5.3-flash",
    "WORKERS_AI_REASONING_EFFORT": "low",
    "SEARCH_EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "SEARCH_EMBEDDING_DIMENSIONS": "1024",
    "COMMENT_ALLOWED_HOSTNAMES": "acecore.net,www.acecore.net,acecore-net.pages.dev,localhost,127.0.0.1",
    "CONTACT_FROM_EMAIL": "noreply@acecore.net",
    "CONTACT_TO_EMAIL": "info@acecore.net",
    "CONTACT_ALLOWED_HOSTNAMES": "acecore.net,www.acecore.net,acecore-net.pages.dev,systems.acecore.net,localhost,127.0.0.1",
    "SEARCH_ENABLED": "false",
    "SEARCH_MIN_SCORE": "0.50",
    "SYSTEMS_SEARCH_ENABLED": "true",
    "SYSTEMS_SEARCH_MIN_SCORE": "0.50",
    "SCHOOLS_SEARCH_ENABLED": "true",
    "SCHOOLS_SEARCH_MIN_SCORE": "0.50",
    "ACESERVER_WIKI_SEARCH_ENABLED": "true",
    "ACESERVER_WIKI_SEARCH_MIN_SCORE": "0.40",
    "ACESERVER_PORTAL_SEARCH_ENABLED": "false",
    "ACESERVER_PORTAL_SEARCH_MIN_SCORE": "0.50",
    "WORLD_FOUNDATION_SEARCH_ENABLED": "false",
    "WORLD_FOUNDATION_SEARCH_MIN_SCORE": "0.40",
  },
  "ai": {
    "binding": "AI",
  },
  "d1_databases": [
    {
      "binding": "COMMENTS_DB",
      "database_name": "acecore-comments",
      "database_id": "3f31c39c-e418-4460-8651-4385e0409157",
      "migrations_dir": "./migrations",
    },
    {
      "binding": "SEARCH_RATE_LIMIT_DB",
      "database_name": "acecore-net-search-production",
      "database_id": "3d26157c-b052-498c-af9b-82bad65b8421",
      "migrations_dir": "./migrations/search",
    },
  ],
  "services": [
    {
      "binding": "CMS_AI",
      "service": "cms-ai",
    },
    {
      "binding": "ACECORE_CHAT",
      "service": "acecore-chat-worker",
    },
  ],
  "env": {
    "preview": {
      "vars": {
        "CLOUDFLARE_ACCOUNT_ID": "db9b62f409f463da7acbcc374b8385d0",
        "WORKERS_AI_CHAT_MODEL": "@cf/zai-org/glm-5.3-flash",
        "WORKERS_AI_REASONING_EFFORT": "low",
        "SEARCH_EMBEDDING_MODEL": "@cf/baai/bge-m3",
        "SEARCH_EMBEDDING_DIMENSIONS": "1024",
        "COMMENT_ALLOWED_HOSTNAMES": "acecore.net,www.acecore.net,acecore-net.pages.dev",
        "CONTACT_FROM_EMAIL": "noreply@acecore.net",
        "CONTACT_TO_EMAIL": "info@acecore.net",
        "CONTACT_ALLOWED_HOSTNAMES": "acecore.net,www.acecore.net,acecore-net.pages.dev,systems.acecore.net",
        "SEARCH_ENABLED": "false",
        "SEARCH_MIN_SCORE": "0.50",
        "SYSTEMS_SEARCH_ENABLED": "true",
        "SYSTEMS_SEARCH_MIN_SCORE": "0.50",
        "SCHOOLS_SEARCH_ENABLED": "true",
        "SCHOOLS_SEARCH_MIN_SCORE": "0.50",
        "ACESERVER_WIKI_SEARCH_ENABLED": "true",
        "ACESERVER_WIKI_SEARCH_MIN_SCORE": "0.40",
        "ACESERVER_PORTAL_SEARCH_ENABLED": "false",
        "ACESERVER_PORTAL_SEARCH_MIN_SCORE": "0.50",
        "WORLD_FOUNDATION_SEARCH_ENABLED": "false",
        "WORLD_FOUNDATION_SEARCH_MIN_SCORE": "0.40",
      },
      "ai": {
        "binding": "AI",
      },
      "d1_databases": [
        {
          "binding": "COMMENTS_DB",
          "database_name": "acecore-comments",
          "database_id": "3f31c39c-e418-4460-8651-4385e0409157",
          "migrations_dir": "./migrations",
        },
        {
          "binding": "SEARCH_RATE_LIMIT_DB",
          "database_name": "acecore-net-search-production",
          "database_id": "3d26157c-b052-498c-af9b-82bad65b8421",
          "migrations_dir": "./migrations/search",
        },
      ],
      "services": [
        {
          "binding": "CMS_AI",
          "service": "cms-ai",
        },
        {
          "binding": "ACECORE_CHAT",
          "service": "acecore-chat-worker-preview",
        },
      ],
    },
    "production": {
      "vectorize": [
        {
          "binding": "SEARCH_INDEX",
          "index_name": "acecore-net-search-bge-m3-1024-production-v1",
        },
        {
          "binding": "SYSTEMS_SEARCH_INDEX",
          "index_name": "acecore-systems-search-bge-m3-1024-production-v1",
        },
        {
          "binding": "SCHOOLS_SEARCH_INDEX",
          "index_name": "acecore-schools-search-bge-m3-1024-production-v1",
        },
        {
          "binding": "ACESERVER_WIKI_SEARCH_INDEX",
          "index_name": "aceserver-wiki-search-bge-m3-1024-production-v1",
        },
        {
          "binding": "ACESERVER_PORTAL_SEARCH_INDEX",
          "index_name": "aceserver-portal-search-bge-m3-1024-production-v1",
        },
        {
          "binding": "WORLD_FOUNDATION_SEARCH_INDEX",
          "index_name": "world-foundation-search-bge-m3-1024-production-v1",
        },
      ],
      "vars": {
        "CLOUDFLARE_ACCOUNT_ID": "db9b62f409f463da7acbcc374b8385d0",
        "WORKERS_AI_CHAT_MODEL": "@cf/zai-org/glm-5.3-flash",
        "WORKERS_AI_REASONING_EFFORT": "low",
        "SEARCH_EMBEDDING_MODEL": "@cf/baai/bge-m3",
        "SEARCH_EMBEDDING_DIMENSIONS": "1024",
        "COMMENT_ALLOWED_HOSTNAMES": "acecore.net,www.acecore.net,acecore-net.pages.dev",
        "CONTACT_FROM_EMAIL": "noreply@acecore.net",
        "CONTACT_TO_EMAIL": "info@acecore.net",
        "CONTACT_ALLOWED_HOSTNAMES": "acecore.net,www.acecore.net,acecore-net.pages.dev,systems.acecore.net",
        "SEARCH_ENABLED": "true",
        "SEARCH_MIN_SCORE": "0.50",
        "SYSTEMS_SEARCH_ENABLED": "true",
        "SYSTEMS_SEARCH_MIN_SCORE": "0.50",
        "SCHOOLS_SEARCH_ENABLED": "true",
        "SCHOOLS_SEARCH_MIN_SCORE": "0.50",
        "ACESERVER_WIKI_SEARCH_ENABLED": "true",
        "ACESERVER_WIKI_SEARCH_MIN_SCORE": "0.40",
        "ACESERVER_PORTAL_SEARCH_ENABLED": "true",
        "ACESERVER_PORTAL_SEARCH_MIN_SCORE": "0.50",
        "WORLD_FOUNDATION_SEARCH_ENABLED": "true",
        "WORLD_FOUNDATION_SEARCH_MIN_SCORE": "0.40",
      },
      "ai": {
        "binding": "AI",
      },
      "d1_databases": [
        {
          "binding": "COMMENTS_DB",
          "database_name": "acecore-comments",
          "database_id": "3f31c39c-e418-4460-8651-4385e0409157",
          "migrations_dir": "./migrations",
        },
        {
          "binding": "SEARCH_RATE_LIMIT_DB",
          "database_name": "acecore-net-search-production",
          "database_id": "3d26157c-b052-498c-af9b-82bad65b8421",
          "migrations_dir": "./migrations/search",
        },
      ],
      "services": [
        {
          "binding": "CMS_AI",
          "service": "cms-ai",
        },
        {
          "binding": "ACECORE_CHAT",
          "service": "acecore-chat-worker",
        },
      ],
    },
  },
}
